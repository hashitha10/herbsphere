<script nonce="">window.__REACT_QUERY_CACHE__["[\"promptStarters\",8,null]"].resolve(({items:[{id:"1b3b651a",title:"Create an image",description:"for my presentation",oneliner:"Create an image for my presentation",prompt:"Can you create an image for my presentation? I need something that visually represents the key points.",theme:"Create image",requires_dalle:!0,category:"dalle"},{id:"546d7231",title:"Create an image",description:"of my pet",oneliner:"Create an image of my pet",prompt:"Can you create an image of my pet? I'd love to have a fun and creative representation.",theme:"Create image",requires_dalle:!0,category:"dalle"},{id:"4c694c02",title:"Create an image",description:"for my website",oneliner:"Create an image for my website",prompt:"Can you create an image for my website? I need something that matches the overall theme and tone.",theme:"Create image",requires_dalle:!0,category:"dalle"},{id:"2e7059f5",title:"Create an image",description:"made out of felt",oneliner:"Create an image made out of felt",prompt:"Can you create an image that looks like it's made out of felt? I'm going for a crafty and textured look.",theme:"Create image",requires_dalle:!0,category:"dalle"},{id:"4ebbc950",title:"Help me",description:"understand trends in my data",oneliner:"Help me understand trends in my data",prompt:"Can you help me understand trends in my data? I need insights into patterns and potential outliers. If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Analyze data",category:"data-vis",requires_python:!0,requires_file_upload:!0},{id:"77d9c8a1",title:"Help me",description:"create a bar chart",oneliner:"Help me create a bar chart",prompt:"Can you help me create a bar chart? I have the data and need a visual representation. If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Analyze data",category:"data-vis",requires_python:!0,requires_file_upload:!0},{id:"89c416b1",title:"Help me",description:"make a scatter plot",oneliner:"Help me make a scatter plot",prompt:"Can you help me make a scatter plot? I want to visualize the relationship between two variables. If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Analyze data",category:"data-vis",requires_python:!0,requires_file_upload:!0},{id:"36bb513e",title:"Help me",description:"interpret a P&L statement",oneliner:"Help me interpret a P&L statement",prompt:"Can you help me interpret my P&L statement? If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Analyze data",category:"data-vis",requires_python:!0,requires_file_upload:!0},{id:"386dcd33",title:"Help me",description:"find what decade a photo is from",oneliner:"Help me find what decade a photo is from",prompt:"Can you determine what decade a photo is from if I share it with you? If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Analyze images",category:"vision",requires_vision:!0,requires_file_upload:!0},{id:"ee0ca7da",title:"Help me",description:"translate text in an image",oneliner:"Help me translate text in an image",prompt:"Can you translate text in an image I share? If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Analyze images",category:"vision",requires_vision:!0,requires_file_upload:!0},{id:"af82c9ba",title:"Help me",description:"write a poem based on an image",oneliner:"Help me write a poem based on an image",prompt:"Can you write a poem based on an image I share? If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Analyze images",category:"vision",requires_vision:!0,requires_file_upload:!0},{id:"3ee74c99",title:"Help me",description:"identify plants in an image",oneliner:"Help me identify plants in an image",prompt:"Can you identify plants in an image I share? If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Analyze images",category:"vision",requires_vision:!0,requires_file_upload:!0},{id:"77ca269c",title:"Help me",description:"debug my code",oneliner:"Help me debug my code",prompt:"Can you help me debug my code? I'll share the code snippet with you.",theme:"Code",category:"code"},{id:"85a8a5f9",title:"Help me",description:"write a function",oneliner:"Help me write a function",prompt:"Can you help me write a function? I have the requirements and need assistance with implementation.",theme:"Code",category:"code"},{id:"07ed7a04",title:"Help me",description:"simplify my code",oneliner:"Help me simplify my code",prompt:"Can you help me simplify my code? I'd like to refactor it for better readability and performance.",theme:"Code",category:"code"},{id:"64e57a28",title:"Help me",description:"learn Python",oneliner:"Help me learn Python",prompt:"Can you help me learn Python? Start by asking me about my current level of programming knowledge.",theme:"Code",category:"code"},{id:"58a3e0b6",title:"Summarize",description:"my lease agreement",oneliner:"Summarize my lease agreement",prompt:"Can you summarize my lease agreement? I want to know the key points and any important clauses. If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Summarize text",category:"file-upload-document",requires_file_upload:!0},{id:"7db8304d",title:"Summarize",description:"notes from a meeting",oneliner:"Summarize notes from a meeting",prompt:"Can you summarize the notes from my meeting? If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Summarize text",category:"file-upload-document",requires_file_upload:!0},{id:"87f60f46",title:"Summarize",description:"chapter 1 of a book",oneliner:"Summarize chapter 1 of a book",prompt:"Can you summarize chapter 1 of a book? I need a brief overview of the key events. If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Summarize text",category:"file-upload-document",requires_file_upload:!0},{id:"6b65daeb",title:"Summarize",description:"a research paper",oneliner:"Summarize a research paper",prompt:"Can you summarize a research paper for me? I need a concise summary of the main findings and conclusions. If you need more information, ask me a follow up question or ask me to upload a file or image.",theme:"Summarize text",category:"file-upload-document",requires_file_upload:!0},{id:"fc3029cd",title:"Brainstorm ideas",description:"for my next vacation",oneliner:"Brainstorm ideas for my next vacation",prompt:"Let's brainstorm ideas for my next vacation. Start by asking what time of year I want to travel.",theme:"Brainstorm",category:"idea"},{id:"d0b8a02b",title:"Brainstorm ideas",description:"for a brand campaign",oneliner:"Brainstorm ideas for a brand campaign",prompt:"Can you help me brainstorm ideas for a brand campaign? Start by asking me about my target audience.",theme:"Brainstorm",category:"idea"},{id:"4cc64126",title:"Brainstorm ideas",description:"for a new workout routine",oneliner:"Brainstorm ideas for a new workout routine",prompt:"Can you help me create a new workout routine?",theme:"Brainstorm",category:"idea"},{id:"dd7f8484",title:"Brainstorm ideas",description:"for a dinner party menu",oneliner:"Brainstorm ideas for a dinner party menu",prompt:"Can you help me brainstorm ideas for a dinner party menu? Let's start with figuring out seasonal ingredients.",theme:"Brainstorm",category:"idea"},{id:"be42e2c4",title:"Make a plan",description:"to get a promotion",oneliner:"Make a plan to get a promotion",prompt:"I want to get promoted at work. Let's talk through the process together and make a detailed plan. Start by asking me about my current role.",theme:"Make a plan",category:"idea"},{id:"7fc44393",title:"Make a plan",description:"to buy a new car",oneliner:"Make a plan to buy a new car",prompt:"I'd like to buy a new car. Start by asking me about my budget and which features I care most about, then provide a recommendation.",theme:"Make a plan",category:"idea"},{id:"6d894365",title:"Make a plan",description:"of meals for the week",oneliner:"Make a plan of meals for the week",prompt:"Help me plan meals for the week. Start by asking what ingredients I already have, and what kinds of meals I enjoy.",theme:"Make a plan",category:"idea"},{id:"26a8621b",title:"Make a plan",description:"for a weekend in New York",oneliner:"Make a plan for a weekend in New York",prompt:"Help me plan a weekend trip to New York. Start by asking about my preferences for activities and the time of year.",theme:"Make a plan",category:"idea"},{id:"cf757c70",title:"Surprise me",description:"with a story about yourself",oneliner:"Surprise me with a story about yourself",prompt:"Can you surprise me with a story about yourself? I'd love to hear something unexpected or interesting.",theme:"Surprise me",category:"misc"},{id:"df4e5926",title:"Surprise me",description:"with my horoscope for today",oneliner:"Surprise me with my horoscope for today",prompt:"Find my horoscope for the day based on my zodiac sign.",theme:"Surprise me",category:"misc"},{id:"99ebe26c",title:"Surprise me",description:"with my seasonal color analysis",oneliner:"Surprise me with my seasonal color analysis",prompt:"Do a seasonal color analysis for me based on a photo.",theme:"Surprise me",category:"misc"},{id:"0a2a8e86",title:"Surprise me",description:"with a tip from the Farmer's Almanac",oneliner:"Surprise me with a tip from the Farmer's Almanac",prompt:"Check the Farmer's Almanac and tell me what today is a good day for.",theme:"Surprise me",category:"misc"}],total:32,limit:8,offset:0}));
