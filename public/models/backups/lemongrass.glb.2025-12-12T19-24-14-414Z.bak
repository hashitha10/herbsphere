    </span><span><span class="hljs-attr">systems</span></span><span>: [</span><span><span class="hljs-string">"Ayurveda"</span></span><span>, </span><span><span class="hljs-string">"Homeopathy"</span></span><span>],
    </span><span><span class="hljs-attr">family</span></span><span>: </span><span><span class="hljs-string">"Lamiaceae"</span></span><span>,
    </span><span><span class="hljs-attr">short</span></span><span>: </span><span><span class="hljs-string">"Holy basil used for immunity &amp; respiratory support."</span></span><span>,
    </span><span><span class="hljs-attr">description</span></span><span>:
      </span><span><span class="hljs-string">"Tulsi (Holy Basil) is an adaptogenic herb used in Ayurveda for respiratory health, immunity and stress relief."</span></span><span>,
