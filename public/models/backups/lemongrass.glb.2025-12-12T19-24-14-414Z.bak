</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">React</span></span><span>, { useMemo, useState } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { useParams } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react-router-dom"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">PlantCard</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../components/PlantCard"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">PlantDetailModal</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../components/PlantDetailModal"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-variable constant_">PLANTS</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../data/plants"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">ZonePage</span></span><span>(</span><span><span class="hljs-params">{ favorites, onToggleFav }</span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> { zoneName } = </span><span><span class="hljs-title function_">useParams</span></span><span>();
  </span><span><span class="hljs-keyword">const</span></span><span> zone = </span><span><span class="hljs-built_in">decodeURIComponent</span></span><span>(zoneName || </span><span><span class="hljs-string">"All"</span></span><span>);
  </span><span><span class="hljs-keyword">const</span></span><span> [selected, setSelected] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-literal">null</span></span><span>);
  </span><span><span class="hljs-keyword">const</span></span><span> [q, setQ] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-string">""</span></span><span>);

  </span><span><span class="hljs-keyword">const</span></span><span> filtered = </span><span><span class="hljs-title function_">useMemo</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> {
    </span><span><span class="hljs-keyword">const</span></span><span> z = zone === </span><span><span class="hljs-string">"All"</span></span><span> ? </span><span><span class="hljs-literal">null</span></span><span> : zone;
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-variable constant_">PLANTS</span></span><span>.</span><span><span class="hljs-title function_">filter</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">p</span></span></span><span> =&gt; (!z || p.</span><span><span class="hljs-property">systems</span></span><span>.</span><span><span class="hljs-title function_">includes</span></span><span>(z)) &amp;&amp; (
      p.</span><span><span class="hljs-property">commonName</span></span><span>.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>().</span><span><span class="hljs-title function_">includes</span></span><span>(q.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>()) ||
      p.</span><span><span class="hljs-property">scientificName</span></span><span>.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>().</span><span><span class="hljs-title function_">includes</span></span><span>(q.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>()) ||
      p.</span><span><span class="hljs-property">short</span></span><span>.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>().</span><span><span class="hljs-title function_">includes</span></span><span>(q.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>())
    ));
  }, [zone, q]);

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-2xl font-bold mb-3"</span></span><span>&gt;{zone} Zone</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mb-4 flex gap-3 items-center"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span> </span><span><span class="hljs-attr">value</span></span><span>=</span><span><span class="hljs-string">{q}</span></span><span> </span><span><span class="hljs-attr">onChange</span></span><span>=</span><span><span class="hljs-string">{e</span></span><span> =&gt; setQ(e.target.value)} placeholder="Search plants in this zone..." className="px-3 py-2 rounded border w-full"/&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"</span></span><span>&gt;
        {filtered.map(p =&gt; (
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">PlantCard</span></span></span><span> </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{p.id}</span></span><span> </span><span><span class="hljs-attr">plant</span></span><span>=</span><span><span class="hljs-string">{p}</span></span><span> </span><span><span class="hljs-attr">onOpen</span></span><span>=</span><span><span class="hljs-string">{setSelected}</span></span><span> </span><span><span class="hljs-attr">isFav</span></span><span>=</span><span><span class="hljs-string">{favorites.includes(p.id)}</span></span><span> </span><span><span class="hljs-attr">onToggleFav</span></span><span>=</span><span><span class="hljs-string">{onToggleFav}</span></span><span> /&gt;
        ))}
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">PlantDetailModal</span></span></span><span> </span><span><span class="hljs-attr">plantId</span></span><span>=</span><span><span class="hljs-string">{selected}</span></span><span> </span><span><span class="hljs-attr">plants</span></span><span>=</span><span><span class="hljs-string">{PLANTS}</span></span><span> </span><span><span class="hljs-attr">onClose</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; setSelected(null)} onToggleFav={onToggleFav} favorites={favorites} /&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
