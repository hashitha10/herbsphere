</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">React</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">Routes</span></span><span>, </span><span><span class="hljs-title class_">Route</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react-router-dom"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">Navbar</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./components/Navbar"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">HomePage</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./pages/HomePage"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">ZonePage</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./pages/ZonePage"</span></span><span>; </span><span><span class="hljs-comment">// we'll implement ZonePage next</span></span><span>
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">QuizPage</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./pages/QuizPage"</span></span><span>; </span><span><span class="hljs-comment">// we will implement later</span></span><span>

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">App</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"min-h-screen bg-gradient-to-b from-emerald-50 to-white"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Navbar</span></span></span><span> /&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">main</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"container mx-auto px-4 py-8"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Routes</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">HomePage</span></span><span> /&gt;} /&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/zone/:zoneName"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">ZonePage</span></span><span> /&gt;} /&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/quiz"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">QuizPage</span></span><span> /&gt;} /&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Routes</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">main</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">footer</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-gray-50 text-center py-4 text-sm text-gray-600"</span></span><span>&gt;© Virtual Herbal Garden</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">footer</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
<blockquote data-start="8371" data-end="8483">
<p data-start="8373" data-end="8483">If <code data-start="8376" data-end="8386">ZonePage</code> or <code data-start="8390" data-end="8400">QuizPage</code> imports break because the files don't exist yet, create placeholder stubs for now:</p>
</blockquote>
