        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-xl font-semibold mb-4"</span></span><span>&gt;Why this project?</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
