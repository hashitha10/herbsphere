</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">React</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">Link</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react-router-dom"</span></span><span>;

</span><span><span class="hljs-keyword">const</span></span><span> zones = [
  </span><span><span class="hljs-string">"Ayurveda"</span></span><span>,
  </span><span><span class="hljs-string">"Yoga &amp; Naturopathy"</span></span><span>,
  </span><span><span class="hljs-string">"Unani"</span></span><span>,
  </span><span><span class="hljs-string">"Siddha"</span></span><span>,
  </span><span><span class="hljs-string">"Homeopathy"</span></span><span>
];

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">ZoneSelector</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"flex flex-wrap gap-3 justify-center my-6"</span></span><span>&gt;
      {zones.map((z) =&gt; (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Link</span></span></span><span>
          </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{z}</span></span><span>
          </span><span><span class="hljs-attr">to</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>`/</span><span><span class="hljs-attr">zone</span></span><span>/${</span><span><span class="hljs-attr">encodeURIComponent</span></span><span>(</span><span><span class="hljs-attr">z</span></span><span>)}`}
          </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-4 py-2 bg-emerald-700 text-white rounded-full shadow hover:bg-emerald-800"</span></span><span>
        &gt;
          {z}
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Link</span></span></span><span>&gt;
      ))}
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
