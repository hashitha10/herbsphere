1057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-comment">// client/src/components/PlantCard.jsx</span></span><span>
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">React</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">PlantCard</span></span><span>(</span><span><span class="hljs-params">{ plant }</span></span><span>) {
  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span>
      </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-white rounded-xl shadow hover:shadow-lg transition cursor-pointer overflow-hidden"</span></span><span>
    &gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"h-40 bg-gray-100"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span>
          </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{plant.image}</span></span><span>
          </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">{plant.commonName}</span></span><span>
          </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"w-full h-full object-cover"</span></span><span>
        /&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"p-4"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-lg font-semibold"</span></span><span>&gt;{plant.commonName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-sm text-gray-500 italic"</span></span><span>&gt;{plant.scientificName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3 flex flex-wrap gap-2"</span></span><span>&gt;
          {plant.systems.map((s) =&gt; (
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span>
              </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{s}</span></span><span>
              </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-2 py-1 text-xs bg-emerald-100 text-emerald-800 rounded-full"</span></span><span>
            &gt;
              {s}
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;
          ))}
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
<p data-start="3688" data-end="3701">This card is:</p>
<p data-start="3703" data-end="3808">✔ Stylish<br data-start="3712" data-end="3715">
✔ Responsive<br data-start="3727" data-end="3730">
✔ Clean<br data-start="3737" data-end="3740">
✔ Shows plant info<br data-start="3758" data-end="3761">
✔ Clickable (we will add modal click in Part C)</p>
<hr data-start="3810" data-end="3813">
<h1 data-start="3815" data-end="3874">🚀 STEP 3 — Ensure your plant data includes AYUSH systems</h1>
<p data-start="3876" data-end="3905">Your <code data-start="3881" data-end="3892">plants.js</code> already has:</p>
