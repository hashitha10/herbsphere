 15.6481 5.00024 15.8021L5.13013 15.8577C5.2739 15.9092 5.46341 15.947 5.74536 15.97C6.12888 16.0014 6.62221 16.0013 7.33325 16.0013H12.6663C13.3771 16.0013 13.8707 16.0014 14.2542 15.97C14.6295 15.9394 14.8413 15.8825 14.9993 15.8021L15.1262 15.7308C15.4136 15.5545 15.6481 15.3014 15.802 14.9993L15.8577 14.8695C15.9091 14.7257 15.9469 14.536 15.97 14.2542C16.0013 13.8707 16.0012 13.3772 16.0012 12.6663V12.5003C16.0012 12.1332 16.2991 11.8355 16.6663 11.8353C17.0335 11.8353 17.3313 12.1331 17.3313 12.5003V12.6663C17.3313 13.3553 17.3319 13.9124 17.2952 14.3626C17.2624 14.7636 17.1974 15.1247 17.053 15.4613L16.9866 15.6038C16.7211 16.1248 16.3172 16.5605 15.8215 16.8646L15.6038 16.9866C15.227 17.1786 14.8206 17.2578 14.3625 17.2952C13.9123 17.332 13.3553 17.3314 12.6663 17.3314H7.33325C6.64416 17.3314 6.0872 17.332 5.63696 17.2952C5.23642 17.2625 4.87552 17.1982 4.53931 17.054L4.39673 16.9866C3.87561 16.7211 3.43911 16.3174 3.13501 15.8216L3.01294 15.6038C2.82097 15.2271 2.74177 14.8206 2.70435 14.3626C2.66758 13.9124 2.66821 13.3553 2.66821 12.6663ZM9.33521 12.5003V4.9388L7.13696 7.13704C6.87732 7.39668 6.45625 7.39657 6.19653 7.13704C5.93684 6.87734 5.93684 6.45631 6.19653 6.19661L9.52954 2.86263L9.6311 2.77962C9.73949 2.70742 9.86809 2.66829 10.0002 2.66829C10.1763 2.66838 10.3454 2.73819 10.47 2.86263L13.804 6.19661C14.0633 6.45628 14.0634 6.87744 13.804 7.13704C13.5443 7.39674 13.1222 7.39674 12.8625 7.13704L10.6653 4.93977V12.5003C10.6651 12.8673 10.3673 13.1652 10.0002 13.1654C9.63308 13.1654 9.33538 12.8674 9.33521 12.5003Z"></path></svg></span></button><button class="text-token-text-secondary hover:bg-token-bg-secondary touch:w-10 flex h-8 w-8 items-center justify-center rounded-lg" aria-label="More actions" type="button" id="radix-_r_21m_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M15.498 8.50159C16.3254 8.50159 16.9959 9.17228 16.9961 9.99963C16.9961 10.8271 16.3256 11.4987 15.498 11.4987C14.6705 11.4987 14 10.8271 14 9.99963C14.0002 9.17228 14.6706 8.50159 15.498 8.50159Z"></path><path d="M4.49805 8.50159C5.32544 8.50159 5.99689 9.17228 5.99707 9.99963C5.99707 10.8271 5.32555 11.4987 4.49805 11.4987C3.67069 11.4985 3 10.827 3 9.99963C3.00018 9.17239 3.6708 8.50176 4.49805 8.50159Z"></path><path d="M10.0003 8.50159C10.8276 8.50176 11.4982 9.17239 11.4984 9.99963C11.4984 10.827 10.8277 11.4985 10.0003 11.4987C9.17283 11.4987 8.50131 10.8271 8.50131 9.99963C8.50149 9.17228 9.17294 8.50159 10.0003 8.50159Z"></path></svg></button></div></div></div></div></article><article class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-(--header-height)" tabindex="-1" dir="auto" data-turn-id="ec5b3cd5-ed23-42a7-8504-c62f30526737" data-testid="conversation-turn-169" data-scroll-anchor="false" data-turn="user"><h5 class="sr-only">You said:</h5><div class="text-base my-auto mx-auto pt-12 [--thread-content-margin:--spacing(4)] thread-sm:[--thread-content-margin:--spacing(6)] thread-lg:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] thread-lg:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col" tabindex="-1"><div class="flex max-w-full flex-col grow"><div data-message-author-role="user" data-message-id="ec5b3cd5-ed23-42a7-8504-c62f30526737" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color relative rounded-[18px] px-4 py-1.5 data-[multiline]:py-3 max-w-[var(--user-chat-width,70%)]" data-multiline=""><div class="whitespace-pre-wrap">import React, { Suspense } from "react";
import { Canvas } from "@react-three/fiber";
import { OrbitControls, Html } from "@react-three/drei";

/* simple placeholder scene with clickable geometric markers.
   You can replace markers with GLTF model loads via &lt;primitive object={gltf.scene} /&gt; */
export default function GardenScene({ onPlantSelect, visiblePlants = [] }) {
  return (
    &lt;div className="h-[520px] rounded-2xl overflow-hidden shadow-lg"&gt;
      &lt;Canvas camera={{ position: [6, 4, 8], fov: 50 }}&gt;
        &lt;color attach="background" args={["#f0fff4"]} /&gt;
        &lt;ambientLight intensity={0.6} /&gt;
        &lt;directionalLight position={[5, 10, 7]} intensity={1} /&gt;
        &lt;Suspense fallback={&lt;Html center&gt;Loading...&lt;/Html&gt;}&gt;
          {/* ground plane */}
          &lt;mesh rotation={[-Math.PI / 2, 0, 0]} receiveShadow&gt;
            &lt;planeGeometry args={[50, 50]} /&gt;
            &lt;meshStandardMaterial color="#e9f7ee" /&gt;
          &lt;/mesh&gt;

          {/* Example clickable markers (replace with plant models) */}
          {visiblePlants.map((p, i) =&gt; (
            &lt;mesh key={p.id} position={[i * 2 - 4, 0.5, (i % 3) * 1.8 - 2]}&gt;
              &lt;sphereGeometry args={[0.6, 32, 32]} /&gt;
              &lt;meshStandardMaterial color="#16a34a" /&gt;
              &lt;mesh
                onClick={(e) =&gt; {
                  e.stopPropagation();
                  onPlantSelect(p.id);
                }}
                // invisible clickable collider
              /&gt;
            &lt;/mesh&gt;
          ))}
        &lt;/Suspense&gt;
        &lt;OrbitControls /&gt;
      &lt;/Canvas&gt;
    &lt;/div&gt;
  );
}</div></div></div></div><div data-message-author-role="user" data-message-id="5b5472ea-4ac3-4745-aff5-115f3ea2560d" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color relative rounded-[18px] px-4 py-1.5 data-[multiline]:py-3 max-w-[var(--user-chat-width,70%)]" data-multiline=""><div class="whitespace-pre-wrap">import React, { useEffect, useState } from "react";


export default function PlantDetailModal({
  plantId,
  plants,
  onClose,
  onToggleFav,
  favorites,
}) {
  const [plant, setPlant] = useState(null);

  useEffect(() =&gt; {
    setPlant(plants.find((p) =&gt; p.id === plantId));
  }, [plantId, plants]);

  if (!plant) return null;

  const isFav = favorites.includes(plant.id);

  return (
    &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-5"&gt;
      &lt;div className="absolute inset-0 bg-black/50" onClick={onClose} /&gt;

      &lt;div className="relative bg-white rounded-2xl w-full max-w-4xl shadow-lg"&gt;
        &lt;div className="p-6 grid grid-cols-1 md:grid-cols-3 gap-6"&gt;
          &lt;div&gt;
            &lt;img src={plant.image} className="rounded-lg h-56 w-full object-cover" /&gt;

            &lt;h2 className="mt-4 text-2xl font-bold"&gt;{plant.commonName}&lt;/h2&gt;
            &lt;p className="italic text-sm text-gray-500"&gt;{plant.scientificName}&lt;/p&gt;

            &lt;div className="mt-3"&gt;
              &lt;p&gt;&lt;strong&gt;Family:&lt;/strong&gt; {plant.family}&lt;/p&gt;
              &lt;p&gt;&lt;strong&gt;Uses:&lt;/strong&gt; {plant.uses?.join(", ")}&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;div className="md:col-span-2"&gt;
            &lt;h3 className="font-semibold text-lg"&gt;Overview&lt;/h3&gt;
            &lt;p className="mt-2 text-gray-700"&gt;{plant.description}&lt;/p&gt;

            &lt;h4 className="font-semibold mt-5"&gt;3D &amp; AR Viewer&lt;/h4&gt;

            &lt;model-viewer
              src={plant.model}
              ios-src={plant.usdz}
              alt={plant.commonName}
              ar
              ar-modes="scene-viewer quick-look webxr"
              auto-rotate
              camera-controls
              style={{ width: "100%", height: "360px" }}
            &gt;&lt;/model-viewer&gt;

            {plant.audio &amp;&amp; (
              &lt;&gt;
                &lt;h4 className="font-semibold mt-5"&gt;Audio Guide&lt;/h4&gt;
                &lt;audio controls src={plant.audio} className="w-full" /&gt;
              &lt;/&gt;
            )}

            &lt;h4 className="font-semibold mt-6"&gt;References&lt;/h4&gt;
            &lt;p className="text-sm text-gray-600"&gt;
              • Ministry of AYUSH  
              • CCRAS  
              • Siddha Pharmacopoeia of India  
              • Unani Pharmacopoeia  
            &lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        &lt;div className="flex justify-between items-center p-4 border-t"&gt;
          &lt;button
            className="px-3 py-2 border rounded"
            onClick={() =&gt; onToggleFav(plant.id)}
          &gt;
            {isFav ? "★ Favorited" : "☆ Add to Favorites"}
          &lt;/button&gt;
          &lt;button className="px-3 py-2 bg-gray-100 rounded" onClick={onClose}&gt;
            Close
          &lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
}</div></div></div></div></div><div class="z-0 flex justify-end"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none focus-within:transition-none hover:transition-none touch:pointer-events-auto touch:opacity-100 duration-300 group-hover/turn-messages:delay-300 pointer-events-none opacity-0 motion-safe:transition-opacity group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:opacity-100 group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:opacity-100 has-data-[state=open]:pointer-events-auto has-data-[state=open]:opacity-100" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4.44063 16.7428 4.63025 16.7797 4.91211 16.8027C5.29563 16.8341 5.78896 16.835 6.5 16.835H9.33301C10.0439 16.835 10.5374 16.8341 10.9209 16.8027C11.2965 16.772 11.508 16.7152 11.666 16.6348L11.793 16.5645C12.0804 16.3881 12.3148 16.1351