    </span><span><span class="hljs-attr">uses</span></span><span>: [</span><span><span class="hljs-string">"Immunity"</span></span><span>, </span><span><span class="hljs-string">"Respiratory"</span></span><span>, </span><span><span class="hljs-string">"Stress"</span></span><span>],
    </span><span><span class="hljs-attr">model</span></span><span>: </span><span><span class="hljs-string">"/models/tulsi.glb"</span></span><span>
