            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">nav</span></span></span><span>&gt;

        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">main</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"container mx-auto px-4 py-8"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Routes</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>
              &lt;&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-3xl font-bold text-center mb-2"</span></span><span>&gt;Explore AYUSH — Virtual Herbal Garden</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-center text-gray-600 mb-6"</span></span><span>&gt;Choose a zone to begin your learning journey.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">ZoneSelector</span></span></span><span> /&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-6"</span></span><span>&gt;
                  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-xl font-semibold mb-3"</span></span><span>&gt;Featured Plants</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
                  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"</span></span><span>&gt;
                    {PLANTS.slice(0,6).map(p =&gt; (
                      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{p.id}</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">Link</span></span></span><span> </span><span><span class="hljs-attr">to</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>`/</span><span><span class="hljs-attr">zone</span></span><span>/${</span><span><span class="hljs-attr">encodeURIComponent</span></span><span>(</span><span><span class="hljs-attr">p.systems</span></span><span>[</span><span><span class="hljs-attr">0</span></span><span>])}`}&gt;{/* simple preview */}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Link</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
                    ))}
                  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
            } /&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/zone/:zoneName"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">ZonePage</span></span><span> </span><span><span class="hljs-attr">favorites</span></span><span>=</span><span><span class="hljs-string">{favorites}</span></span><span> </span><span><span class="hljs-attr">onToggleFav</span></span><span>=</span><span><span class="hljs-string">{toggleFav}</span></span><span> /&gt;} /&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Routes</span></span></span><span>&gt;
