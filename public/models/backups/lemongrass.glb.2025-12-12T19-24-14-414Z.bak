.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">React</span></span><span>, { useEffect, useState } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-variable constant_">PLANTS</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../data/plants"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">QuizPage</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [questions, setQuestions] = </span><span><span class="hljs-title function_">useState</span></span><span>([]);
  </span><span><span class="hljs-keyword">const</span></span><span> [i, setI] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>);
  </span><span><span class="hljs-keyword">const</span></span><span> [score, setScore] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>);

  </span><span><span class="hljs-title function_">useEffect</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> {
    </span><span><span class="hljs-keyword">const</span></span><span> pool = </span><span><span class="hljs-variable constant_">PLANTS</span></span><span>.</span><span><span class="hljs-title function_">flatMap</span></span><span>(</span><span><span class="hljs-function">(<span class="hljs-params">p</span></span></span><span>) =&gt;
      (p.</span><span><span class="hljs-property">quiz</span></span><span> || []).</span><span><span class="hljs-title function_">map</span></span><span>(</span><span><span class="hljs-function">(<span class="hljs-params">q</span></span></span><span>) =&gt; ({ ...q, </span><span><span class="hljs-attr">plant</span></span><span>: p.</span><span><span class="hljs-property">commonName</span></span><span> }))
    );
    </span><span><span class="hljs-title function_">setQuestions</span></span><span>(pool);
  }, []);

  </span><span><span class="hljs-keyword">if</span></span><span> (!questions.</span><span><span class="hljs-property">length</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span></span><span>&gt;No quiz available</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;;

  </span><span><span class="hljs-keyword">const</span></span><span> q = questions[i];

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-2xl font-bold mb-4"</span></span><span>&gt;Quiz</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;

      {i &gt;= questions.length ? (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-white p-6 rounded shadow"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;Your Score</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-2"</span></span><span>&gt;{score} / {questions.length}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span>
            </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4 px-4 py-2 border rounded"</span></span><span>
            </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; {
              setI(0); setScore(0);
            }}
          &gt;
            Retry
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      ) : (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-white p-5 rounded shadow"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;{q.plant}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-2"</span></span><span>&gt;{q.q}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4"</span></span><span>&gt;
            {q.choices.map((c, idx) =&gt; (
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span>
                </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{c}</span></span><span>
                </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"border rounded px-3 py-2"</span></span><span>
                </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; {
                  if (idx === q.a) setScore(score + 1);
                  setI(i + 1);
                }}
              &gt;
                {c}
              </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
            ))}
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      )}
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
