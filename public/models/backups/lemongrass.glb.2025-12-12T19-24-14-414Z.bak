</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">HomePage</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./Pages/HomePage"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">PlantModal</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./components/PlantModal"</span></span><span>;

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">App</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {

  </span><span><span class="hljs-keyword">const</span></span><span> [selectedPlant, setSelectedPlant] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-literal">null</span></span><span>);

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;&gt;</span></span></span><span>
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">HomePage</span></span></span><span> 
        </span><span><span class="hljs-attr">onPlantClick</span></span><span>=</span><span><span class="hljs-string">{(plant)</span></span><span> =&gt; setSelectedPlant(plant)} 
      /&gt;

      {selectedPlant &amp;&amp; (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">PlantModal</span></span></span><span>
          </span><span><span class="hljs-attr">plant</span></span><span>=</span><span><span class="hljs-string">{selectedPlant}</span></span><span>
          </span><span><span class="hljs-attr">onClose</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; setSelectedPlant(null)}
        /&gt;
      )}
    </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
  );
}

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">App</span></span><span>;
</span></span></code></div></div></pre>
<hr data-start="665" data-end="668">
<h1 data-start="670" data-end="704">✅ <strong data-start="674" data-end="704">Everything is correct here</strong></h1>
<h3 data-start="706" data-end="730">✔ <code data-start="712" data-end="728">useState(null)</code></h3>
<p data-start="731" data-end="769">Creates your modal selection variable.</p>
<h3 data-start="771" data-end="830">✔ <code data-start="777" data-end="828">onPlantClick={(plant) =&gt; setSelectedPlant(plant)}</code></h3>
<p data-start="831" data-end="905">Passes a callback to HomePage so clicking a plant sets the selected plant.</p>
<h3 data-start="907" data-end="958">✔ Modal appears only when a plant is selected</h3>
