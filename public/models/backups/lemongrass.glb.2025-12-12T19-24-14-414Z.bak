    </span><span><span class="hljs-attr">uses</span></span><span>: [</span><span><span class="hljs-string">"Stress"</span></span><span>, </span><span><span class="hljs-string">"Energy"</span></span><span>, </span><span><span class="hljs-string">"Sleep"</span></span><span>],
    </span><span><span class="hljs-attr">model</span></span><span>: </span><span><span class="hljs-string">"/models/ashwagandha.glb"</span></span><span>
  },
