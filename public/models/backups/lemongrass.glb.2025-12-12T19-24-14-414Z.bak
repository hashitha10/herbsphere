        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{plant.image}</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">{plant.commonName}</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"w-full h-40 object-cover rounded-md"</span></span><span> /&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3 font-semibold text-lg"</span></span><span>&gt;{plant.commonName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-xs italic text-gray-500"</span></span><span>&gt;{plant.scientificName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-2 text-sm text-gray-700"</span></span><span>&gt;{plant.short}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3 flex justify-between items-center"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"flex gap-2 text-xs"</span></span><span>&gt;
          {plant.systems.map(s =&gt; </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{s}</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-green-100 text-green-800 px-2 py-0.5 rounded"</span></span><span>&gt;{s}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;)}
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span>
          </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{(e)</span></span><span> =&gt; { e.stopPropagation(); onToggleFav(plant.id); }}
          className="px-2 py-1 border rounded"
          aria-label="toggle-fav"
        &gt;
          {isFav ? "★" : "☆"}
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">article</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
