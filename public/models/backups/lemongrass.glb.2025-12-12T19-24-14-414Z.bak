</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-variable constant_">PLANTS</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../data/plants"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">HomePage</span></span><span>(</span><span><span class="hljs-params">{ onPlantClick }</span></span><span>) {
  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">section</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"rounded-2xl p-8 bg-gradient-to-r from-emerald-100 to-white shadow-md"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"container mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6 items-center"</span></span><span>&gt;
          
          {/* LEFT SIDE TEXT */}
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-4xl font-bold text-emerald-900"</span></span><span>&gt;Virtual Herbal Garden</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4 text-gray-700"</span></span><span>&gt;
              Explore the rich variety of medicinal plants across AYUSH traditions.
              Click a zone below to begin learning with 3D models, AR previews, audio guides and quizzes.
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-6"</span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">ZoneSelector</span></span></span><span> /&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

          {/* RIGHT SIDE FEATURE PLANTS */}
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"hidden lg:block"</span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"grid grid-cols-2 gap-3"</span></span><span>&gt;
              {PLANTS.slice(0, 4).map((p) =&gt; (
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> 
                  </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{p.id}</span></span><span> 
                  </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-white rounded-lg overflow-hidden shadow cursor-pointer"</span></span><span>
                  </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; onPlantClick(p)}   // &lt;-- important
                &gt;
                  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{p.image}</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">{p.commonName}</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"w-full h-32 object-cover"</span></span><span> /&gt;
                  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"p-3"</span></span><span>&gt;
                    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h4</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;{p.commonName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h4</span></span></span><span>&gt;
                    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-xs text-gray-500"</span></span><span>&gt;{p.scientificName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
                  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
              ))}
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3 text-sm text-gray-500"</span></span><span>&gt;Featured plants — click a plant to learn more.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;

