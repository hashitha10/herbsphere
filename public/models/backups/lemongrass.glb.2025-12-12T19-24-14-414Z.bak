        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Link</span></span></span><span> </span><span><span class="hljs-attr">to</span></span><span>=</span><span><span class="hljs-string">"/quiz"</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"hover:text-emerald-700"</span></span><span>&gt;Quiz</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Link</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Link</span></span></span><span> </span><span><span class="hljs-attr">to</span></span><span>=</span><span><span class="hljs-string">"/favorites"</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"hover:text-emerald-700"</span></span><span>&gt;Favorites</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Link</span></span></span><span>&gt;
