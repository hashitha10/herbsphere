.6348 11.666L16.6914 11.5361C16.7428 11.3924 16.7797 11.2026 16.8027 10.9209C16.8341 10.5374 16.835 10.0439 16.835 9.33301V6.5C16.835 5.78896 16.8341 5.29563 16.8027 4.91211C16.7797 4.63025 16.7428 4.44063 16.6914 4.29688L16.6348 4.16699C16.4807 3.86474 16.2466 3.61186 15.959 3.43555L15.833 3.36524C15.675 3.28473 15.4636 3.22797 15.0879 3.19727C14.7044 3.16593 14.211 3.16504 13.5 3.16504H10.667C9.9561 3.16504 9.46259 3.16595 9.0791 3.19727C8.79739 3.22028 8.6076 3.2572 8.46387 3.30859L8.33399 3.36524C8.03176 3.51923 7.77886 3.75343 7.60254 4.04102L7.53125 4.16699C7.4508 4.32498 7.39397 4.53655 7.36328 4.91211C7.33985 5.19893 7.33562 5.54719 7.33399 6.00195H9.33301C10.022 6.00195 10.5791 6.00131 11.0293 6.03809C11.4873 6.07551 11.8937 6.15471 12.2705 6.34668L12.4883 6.46875C12.984 6.7728 13.3878 7.20854 13.6533 7.72949L13.7197 7.87207C13.8642 8.20859 13.9292 8.56974 13.9619 8.9707C13.9987 9.42092 13.998 9.97799 13.998 10.667V12.665ZM18.165 9.33301C18.165 10.022 18.1657 10.5791 18.1289 11.0293C18.0961 11.4302 18.0311 11.7914 17.8867 12.1279L17.8203 12.2705C17.5549 12.7914 17.1509 13.2272 16.6553 13.5313L16.4365 13.6533C16.0599 13.8452 15.6541 13.9245 15.1963 13.9619C14.8593 13.9895 14.4624 13.9935 13.9951 13.9951C13.9935 14.4624 13.9895 14.8593 13.9619 15.1963C13.9292 15.597 13.864 15.9576 13.7197 16.2939L13.6533 16.4365C13.3878 16.9576 12.9841 17.3941 12.4883 17.6982L12.2705 17.8203C11.8937 18.0123 11.4873 18.0915 11.0293 18.1289C10.5791 18.1657 10.022 18.165 9.33301 18.165H6.5C5.81091 18.165 5.25395 18.1657 4.80371 18.1289C4.40306 18.0962 4.04235 18.031 3.70606 17.8867L3.56348 17.8203C3.04244 17.5548 2.60585 17.151 2.30176 16.6553L2.17969 16.4365C1.98788 16.0599 1.90851 15.6541 1.87109 15.1963C1.83431 14.746 1.83496 14.1891 1.83496 13.5V10.667C1.83496 9.978 1.83432 9.42091 1.87109 8.9707C1.90851 8.5127 1.98772 8.10625 2.17969 7.72949L2.30176 7.51172C2.60586 7.0159 3.04236 6.6122 3.56348 6.34668L3.70606 6.28027C4.04237 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">React</span></span><span>, { useMemo, useState } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { useParams } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react-router-dom"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-variable constant_">PLANTS</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../data/plants"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">PlantCard</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../components/PlantCard"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">PlantDetailModal</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../components/PlantDetailModal"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">ZonePage</span></span><span>(</span><span><span class="hljs-params">{ favorites, onToggleFav }</span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> { zoneName } = </span><span><span class="hljs-title function_">useParams</span></span><span>();
  </span><span><span class="hljs-keyword">const</span></span><span> zone = </span><span><span class="hljs-built_in">decodeURIComponent</span></span><span>(zoneName);
  </span><span><span class="hljs-keyword">const</span></span><span> [selected, setSelected] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-literal">null</span></span><span>);
  </span><span><span class="hljs-keyword">const</span></span><span> [q, setQ] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-string">""</span></span><span>);

  </span><span><span class="hljs-keyword">const</span></span><span> filtered = </span><span><span class="hljs-title function_">useMemo</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> {
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-variable constant_">PLANTS</span></span><span>.</span><span><span class="hljs-title function_">filter</span></span><span>(
      </span><span><span class="hljs-function">(<span class="hljs-params">p</span></span></span><span>) =&gt;
        p.</span><span><span class="hljs-property">systems</span></span><span>.</span><span><span class="hljs-title function_">includes</span></span><span>(zone) &amp;&amp;
        (p.</span><span><span class="hljs-property">commonName</span></span><span>.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>().</span><span><span class="hljs-title function_">includes</span></span><span>(q.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>()) ||
          p.</span><span><span class="hljs-property">scientificName</span></span><span>.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>().</span><span><span class="hljs-title function_">includes</span></span><span>(q.</span><span><span class="hljs-title function_">toLowerCase</span></span><span>()))
    );
  }, [zone, q]);

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;&gt;</span></span></span><span>
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-3xl font-bold mb-4"</span></span><span>&gt;{zone} — Medicinal Plants</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">input</span></span></span><span>
        </span><span><span class="hljs-attr">value</span></span><span>=</span><span><span class="hljs-string">{q}</span></span><span>
        </span><span><span class="hljs-attr">onChange</span></span><span>=</span><span><span class="hljs-string">{(e)</span></span><span> =&gt; setQ(e.target.value)}
        placeholder="Search plants..."
        className="px-3 py-2 border rounded w-full mb-5"
      /&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"</span></span><span>&gt;
        {filtered.map((p) =&gt; (
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">PlantCard</span></span></span><span>
            </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{p.id}</span></span><span>
            </span><span><span class="hljs-attr">plant</span></span><span>=</span><span><span class="hljs-string">{p}</span></span><span>
            </span><span><span class="hljs-attr">onOpen</span></span><span>=</span><span><span class="hljs-string">{setSelected}</span></span><span>
            </span><span><span class="hljs-attr">onToggleFav</span></span><span>=</span><span><span class="hljs-string">{onToggleFav}</span></span><span>
            </span><span><span class="hljs-attr">isFav</span></span><span>=</span><span><span class="hljs-string">{favorites.includes(p.id)}</span></span><span>
          /&gt;
        ))}
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">PlantDetailModal</span></span></span><span>
        </span><span><span class="hljs-attr">plantId</span></span><span>=</span><span><span class="hljs-string">{selected}</span></span><span>
        </span><span><span class="hljs-attr">plants</span></span><span>=</span><span><span class="hljs-string">{PLANTS}</span></span><span>
        </span><span><span class="hljs-attr">onClose</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; setSelected(null)}
        onToggleFav={onToggleFav}
        favorites={favorites}
      /&gt;
    </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
  );
}
</span></span></code></div></div></pre>
