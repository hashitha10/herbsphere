h d="M15.498 8.50159C16.3254 8.50159 16.9959 9.17228 16.9961 9.99963C16.9961 10.8271 16.3256 11.4987 15.498 11.4987C14.6705 11.4987 14 10.8271 14 9.99963C14.0002 9.17228 14.6706 8.50159 15.498 8.50159Z"></path><path d="M4.49805 8.50159C5.32544 8.50159 5.99689 9.17228 5.99707 9.99963C5.99707 10.8271 5.32555 11.4987 4.49805 11.4987C3.67069 11.4985 3 10.827 3 9.99963C3.00018 9.17239 3.6708 8.50176 4.49805 8.50159Z"></path><path d="M10.0003 8.50159C10.8276 8.50176 11.4982 9.17239 11.4984 9.99963C11.4984 10.827 10.8277 11.4985 10.0003 11.4987C9.17283 11.4987 8.50131 10.8271 8.50131 9.99963C8.50149 9.17228 9.17294 8.50159 10.0003 8.50159Z"></path></svg></button></div></div></div></div></article><article class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-(--header-height)" tabindex="-1" dir="auto" data-turn-id="6de1808e-5e61-4f3c-b92c-5ae333718cf9" data-testid="conversation-turn-191" data-scroll-anchor="false" data-turn="user"><h5 class="sr-only">You said:</h5><div class="text-base my-auto mx-auto pt-12 [--thread-content-margin:--spacing(4)] thread-sm:[--thread-content-margin:--spacing(6)] thread-lg:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] thread-lg:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col" tabindex="-1"><div class="flex max-w-full flex-col grow"><div data-message-author-role="user" data-message-id="6de1808e-5e61-4f3c-b92c-5ae333718cf9" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color relative rounded-[18px] px-4 py-1.5 data-[multiline]:py-3 max-w-[var(--user-chat-width,70%)]" data-multiline=""><div class="whitespace-pre-wrap">// client/src/pages/HomePage.jsx
import React from "react";
import ZoneSelector from "../components/ZoneSelector";
import { PLANTS } from "../data/plants";

export default function HomePage() {
  return (
    &lt;div&gt;
      &lt;section className="rounded-2xl p-8 bg-gradient-to-r from-emerald-100 to-white shadow-md"&gt;
        &lt;div className="container mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6 items-center"&gt;
          &lt;div&gt;
            &lt;h1 className="text-4xl font-bold text-emerald-900"&gt;Virtual Herbal Garden&lt;/h1&gt;
            &lt;p className="mt-4 text-gray-700"&gt;
              Explore the rich variety of medicinal plants across AYUSH traditions.
              Click a zone below to begin learning with 3D models, AR previews, audio guides and quizzes.
            &lt;/p&gt;

            &lt;div className="mt-6"&gt;
              &lt;ZoneSelector /&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;div className="hidden lg:block"&gt;
            &lt;div className="grid grid-cols-2 gap-3"&gt;
              {PLANTS.slice(0, 4).map((p) =&gt; (
                &lt;div key={p.id} className="bg-white rounded-lg overflow-hidden shadow"&gt;
                  &lt;img src={p.image} alt={p.commonName} className="w-full h-32 object-cover" /&gt;
                  &lt;div className="p-3"&gt;
                    &lt;h4 className="font-semibold"&gt;{p.commonName}&lt;/h4&gt;
                    &lt;p className="text-xs text-gray-500"&gt;{p.scientificName}&lt;/p&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              ))}
            &lt;/div&gt;
            &lt;p className="mt-3 text-sm text-gray-500"&gt;Featured plants — click a zone to explore.&lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/section&gt;

      &lt;section className="mt-8"&gt;
        &lt;h2 className="text-xl font-semibold mb-4"&gt;Why this project?&lt;/h2&gt;
        &lt;p className="text-gray-700"&gt;
          This educational app demonstrates AYUSH herbs, their uses, and interactive learning tools. Suitable for students and practitioners.
        &lt;/p&gt;
      &lt;/section&gt;
    &lt;/div&gt;
  );
}
