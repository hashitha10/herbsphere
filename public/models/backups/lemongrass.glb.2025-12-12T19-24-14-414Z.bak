</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">BrowserRouter</span></span><span>, </span><span><span class="hljs-title class_">Routes</span></span><span>, </span><span><span class="hljs-title class_">Route</span></span><span>, </span><span><span class="hljs-title class_">Link</span></span><span>, useNavigate } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react-router-dom"</span></span><span>;
