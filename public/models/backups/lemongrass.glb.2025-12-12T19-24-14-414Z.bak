</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">Link</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react-router-dom"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">Navbar</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
