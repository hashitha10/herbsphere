                    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h4</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;{p.commonName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h4</span></span></span><span>&gt;
