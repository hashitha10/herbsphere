          </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-4 py-2 bg-emerald-600 text-white rounded-full shadow hover:bg-emerald-800 transition"</span></span><span>
        &gt;
          {z}
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Link</span></span></span><span>&gt;
      ))}
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
<p data-start="3737" data-end="3811"><strong data-start="3737" data-end="3745">Why:</strong> big clickable chips that route to the zone page we’ll build next.</p>
