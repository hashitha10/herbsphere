</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">React</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">ReactDOM</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react-dom/client"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">App</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./App"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-string">"./index.css"</span></span><span>;

</span><span><span class="hljs-comment">// add this line:</span></span><span>
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-string">"@google/model-viewer"</span></span><span>;

</span><span><span class="hljs-title class_">ReactDOM</span></span><span>.</span><span><span class="hljs-title function_">createRoot</span></span><span>(</span><span><span class="hljs-variable language_">document</span></span><span>.</span><span><span class="hljs-title function_">getElementById</span></span><span>(</span><span><span class="hljs-string">"root"</span></span><span>)).</span><span><span class="hljs-title function_">render</span></span><span>(
  </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">React.StrictMode</span></span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">App</span></span></span><span> /&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">React.StrictMode</span></span></span><span>&gt;
);
</span></span></code></div></div></pre>
<hr data-start="1270" data-end="1273">
<h2 data-start="1275" data-end="1374">2) Add model fields to your plants &amp; update <code data-start="1322" data-end="1330">PLANTS</code> (paste this replacing your existing PLANTS)</h2>
<p data-start="1376" data-end="1546">This expanded list includes <code data-start="1404" data-end="1411">model</code> (GLB) and <code data-start="1422" data-end="1428">usdz</code> (iOS Quick Look) <strong data-start="1446" data-end="1462">placeholders</strong>. You’ll host those files in <code data-start="1491" data-end="1515">public/models/&lt;id&gt;.glb</code> and <code data-start="1520" data-end="1545">public/models/&lt;id&gt;.usdz</code>.</p>
