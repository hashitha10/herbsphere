</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">ZoneSelector</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./components/ZoneSelector"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">ZonePage</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./pages/ZonePage"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">QuizPage</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./pages/QuizPage"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-variable constant_">PLANTS</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./data/plants"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">App</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [favorites, setFavorites] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> {
    </span><span><span class="hljs-keyword">try</span></span><span> { </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-title class_">JSON</span></span><span>.</span><span><span class="hljs-title function_">parse</span></span><span>(</span><span><span class="hljs-variable language_">localStorage</span></span><span>.</span><span><span class="hljs-title function_">getItem</span></span><span>(</span><span><span class="hljs-string">"vhg:favorites"</span></span><span>)) || []; } </span><span><span class="hljs-keyword">catch</span></span><span> { </span><span><span class="hljs-keyword">return</span></span><span> []; }
  });
  </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">toggleFav</span></span><span>(</span><span><span class="hljs-params">id</span></span><span>) {
    </span><span><span class="hljs-title function_">setFavorites</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">prev</span></span></span><span> =&gt; {
      </span><span><span class="hljs-keyword">const</span></span><span> next = prev.</span><span><span class="hljs-title function_">includes</span></span><span>(id) ? prev.</span><span><span class="hljs-title function_">filter</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">x</span></span></span><span> =&gt; x !== id) : [...prev, id];
      </span><span><span class="hljs-variable language_">localStorage</span></span><span>.</span><span><span class="hljs-title function_">setItem</span></span><span>(</span><span><span class="hljs-string">"vhg:favorites"</span></span><span>, </span><span><span class="hljs-title class_">JSON</span></span><span>.</span><span><span class="hljs-title function_">stringify</span></span><span>(next));
      </span><span><span class="hljs-keyword">return</span></span><span> next;
    });
  }

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"min-h-screen bg-gradient-to-b from-emerald-50 to-white"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Navbar</span></span></span><span> /&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">main</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"container mx-auto px-4 py-8"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Routes</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>
            &lt;&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-3xl font-bold text-center text-emerald-900"</span></span><span>&gt;🌿 Virtual Herbal Garden</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-center text-gray-600 mb-6"</span></span><span>&gt;Explore AYUSH — choose a zone</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">ZoneSelector</span></span></span><span> /&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">section</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-8"</span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-xl font-semibold mb-4"</span></span><span>&gt;Featured Plants</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"</span></span><span>&gt;
                  {PLANTS.slice(0, 6).map(p =&gt; (
                    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{p.id}</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-white rounded p-4 shadow"</span></span><span>&gt;
                      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{p.image}</span></span><span> </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">{p.commonName}</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"w-full h-40 object-cover rounded"</span></span><span> /&gt;
                      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3 font-semibold"</span></span><span>&gt;{p.commonName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
                      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-sm text-gray-600"</span></span><span>&gt;{p.short}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
                      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">Link</span></span></span><span> </span><span><span class="hljs-attr">to</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>`/</span><span><span class="hljs-attr">zone</span></span><span>/${</span><span><span class="hljs-attr">encodeURIComponent</span></span><span>(</span><span><span class="hljs-attr">p.systems</span></span><span>[</span><span><span class="hljs-attr">0</span></span><span>])}`} </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-emerald-700 underline"</span></span><span>&gt;Open zone</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Link</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
                    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
                  ))}
                </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
          } /&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/zone/:zoneName"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">ZonePage</span></span><span> </span><span><span class="hljs-attr">favorites</span></span><span>=</span><span><span class="hljs-string">{favorites}</span></span><span> </span><span><span class="hljs-attr">onToggleFav</span></span><span>=</span><span><span class="hljs-string">{toggleFav}</span></span><span> /&gt;} /&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/quiz"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">QuizPage</span></span><span> /&gt;} /&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Routes</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">main</span></span></span><span>&gt;

      </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">footer</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-gray-50 text-center py-4 text-sm text-gray-600"</span></span><span>&gt;© Virtual Herbal Garden — AYUSH educational demo</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">footer</span></span></span><span>&gt;
    &lt;/div&gt;
  );
}
</span></span></code></div></div></pre>
<hr data-start="19629" data-end="19632">
<h1 data-start="19634" data-end="19651">Asset placement</h1>
<ul data-start="19652" data-end="19832">
<li data-start="19652" data-end="19739">
<p data-start="19654" data-end="19739">3D models: <code data-start="19665" data-end="19693">client/public/models/*.glb</code> and optionally <code data-start="19709" data-end="19717">*.usdz</code> for iOS Quick Look.</p>
</li>
<li data-start="19740" data-end="19778">
<p data-start="19742" data-end="19778">Audio: <code data-start="19749" data-end="19776">client/public/audio/*.mp3</code></p>
</li>
<li data-start="19779" data-end="19832">
<p data-start="19781" data-end="19832">Images: external or <code data-start="19801" data-end="19818">public/images/*</code> (if local).</p>
</li>
</ul>
<p data-start="19834" data-end="19917">Use the sample <code data-start="19849" data-end="19856">model</code>/<code data-start="19857" data-end="19864">audio</code> fields in <code data-start="19875" data-end="19891">data/plants.js</code> to reference these paths.</p>
<hr data-start="19919" data-end="19922">
<h1 data-start="19924" data-end="19965">Tips to maximize marks (implement ASAP)</h1>
<ol data-start="19966" data-end="20623">
<li data-start="19966" data-end="20040">
<p data-start="19969" data-end="20040"><strong data-start="19969" data-end="19988">Populate PLANTS</strong> to 30–100 entries with citations (AYUSH sources).</p>
</li>
<li data-start="20041" data-end="20217">
<p data-start="20044" data-end="20217"><strong data-start="20044" data-end="20072">Replace geometry markers</strong> in GardenScene with real GLTF plant models (<code data-start="20117" data-end="20126">useGLTF</code>) and position them in a pleasing virtual garden layout. Use <code data-start="20187" data-end="20206">@react-three/drei</code> helpers.</p>
</li>
<li data-start="20218" data-end="20310">
<p data-start="20221" data-end="20310"><strong data-start="20221" data-end="20241">Add admin upload</strong> (backend + frontend) to upload GLB/audio and create plant records.</p>
</li>
<li data-start="20311" data-end="20414">
<p data-start="20314" data-end="20414"><strong data-start="20314" data-end="20331">Accessibility</strong>: add ARIA labels, keyboard focus states, and run Lighthouse accessibility audit.</p>
</li>
<li data-start="20415" data-end="20511">
<p data-start="20418" data-end="20511"><strong data-start="20418" data-end="20429">Testing</strong>: add Vitest + React Testing Library tests for core UI (PlantCard, modal, quiz).</p>
</li>
<li data-start="20512" data-end="20623">
<p data-start="20515" data-end="20623"><strong data-start="20515" data-end="20532">Documentation</strong>: produce a PDF report, README, and a 3–4 minute demo video showing AR on an Android phone.</p>
</li>
</ol>
<hr data-start="20625" data-end="20628">
<h1 data-start="20630" data-end="20646">Run dev server</h1>
