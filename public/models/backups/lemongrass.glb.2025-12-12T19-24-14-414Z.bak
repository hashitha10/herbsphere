</span><span><span class="hljs-keyword">const</span></span><span> zones = [</span><span><span class="hljs-string">"Ayurveda"</span></span><span>,</span><span><span class="hljs-string">"Yoga &amp; Naturopathy"</span></span><span>,</span><span><span class="hljs-string">"Unani"</span></span><span>,</span><span><span class="hljs-string">"Siddha"</span></span><span>,</span><span><span class="hljs-string">"Homeopathy"</span></span><span>];

