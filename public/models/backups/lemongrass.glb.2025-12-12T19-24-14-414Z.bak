</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-string">"@google/model-viewer"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">ARViewer</span></span><span>(</span><span><span class="hljs-params">{ model, usdz }</span></span><span>) {
  </span><span><span class="hljs-keyword">if</span></span><span> (!model) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span></span><span>&gt;No 3D model available.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;;

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">model-viewer</span></span></span></span><span>
      </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{model}</span></span><span>
      </span><span><span class="hljs-attr">ios-src</span></span><span>=</span><span><span class="hljs-string">{usdz}</span></span><span>
      </span><span><span class="hljs-attr">ar</span></span><span>
      </span><span><span class="hljs-attr">auto-rotate</span></span><span>
      </span><span><span class="hljs-attr">camera-controls</span></span><span>
      </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">width:</span></span><span> "</span><span><span class="hljs-attr">100</span></span><span>%", </span><span><span class="hljs-attr">height:</span></span><span> "</span><span><span class="hljs-attr">250px</span></span><span>" }}
    &gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">model-viewer</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
