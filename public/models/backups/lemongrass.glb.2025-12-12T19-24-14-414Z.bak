</li>
<li data-start="948" data-end="967">
<p data-start="950" data-end="967">main.jsx config</p>
</li>
<li data-start="968" data-end="988">
<p data-start="970" data-end="988">folder structure</p>
</li>
</ul>
<hr data-start="990" data-end="993">
