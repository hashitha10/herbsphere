</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-variable constant_">PLANTS</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"../data/plants"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">QuizPage</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [qs, setQs] = </span><span><span class="hljs-title function_">useState</span></span><span>([]);
  </span><span><span class="hljs-keyword">const</span></span><span> [i, setI] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>);
  </span><span><span class="hljs-keyword">const</span></span><span> [score, setScore] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-number">0</span></span><span>);

  </span><span><span class="hljs-title function_">useEffect</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> {
    </span><span><span class="hljs-keyword">const</span></span><span> pool = </span><span><span class="hljs-variable constant_">PLANTS</span></span><span>.</span><span><span class="hljs-title function_">flatMap</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">p</span></span></span><span> =&gt; (p.</span><span><span class="hljs-property">quiz</span></span><span> || []).</span><span><span class="hljs-title function_">map</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">q</span></span></span><span> =&gt; ({ ...q, </span><span><span class="hljs-attr">plant</span></span><span>: p.</span><span><span class="hljs-property">commonName</span></span><span> })));
    </span><span><span class="hljs-title function_">setQs</span></span><span>(pool);
  }, []);

  </span><span><span class="hljs-keyword">if</span></span><span> (!qs.</span><span><span class="hljs-property">length</span></span><span>) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-sm text-gray-600"</span></span><span>&gt;No quizzes added yet.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;;
  </span><span><span class="hljs-keyword">const</span></span><span> q = qs[i];

  </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">answer</span></span><span>(</span><span><span class="hljs-params">idx</span></span><span>) {
    </span><span><span class="hljs-keyword">if</span></span><span> (idx === q.</span><span><span class="hljs-property">a</span></span><span>) </span><span><span class="hljs-title function_">setScore</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">s</span></span></span><span> =&gt; s + </span><span><span class="hljs-number">1</span></span><span>);
    </span><span><span class="hljs-title function_">setI</span></span><span>(</span><span><span class="hljs-function"><span class="hljs-params">prev</span></span></span><span> =&gt; prev + </span><span><span class="hljs-number">1</span></span><span>);
  }

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-2xl font-bold mb-4"</span></span><span>&gt;Mini Quiz</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;
      {i &gt;= qs.length ? (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-white p-6 rounded shadow"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;Results</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-2"</span></span><span>&gt;You scored {score} / {qs.length}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4 px-4 py-2 border rounded"</span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; { setI(0); setScore(0); }}&gt;Retry</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      ) : (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-white p-6 rounded shadow"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;{q.plant}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-2"</span></span><span>&gt;{q.q}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3"</span></span><span>&gt;
            {q.choices.map((c, idx) =&gt; </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{c}</span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; answer(idx)} className="px-4 py-2 border rounded text-left"&gt;{c}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;)}
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      )}
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
