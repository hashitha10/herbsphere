      </span><span><span class="hljs-attr">auto-rotate</span></span><span>
      </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">width:</span></span><span> "</span><span><span class="hljs-attr">100</span></span><span>%", </span><span><span class="hljs-attr">height:</span></span><span> "</span><span><span class="hljs-attr">350px</span></span><span>" }}
    &gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">model-viewer</span></span></span><span>&gt;

    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"flex gap-3 mt-4"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span>
        </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">{plant.model}</span></span><span>
        </span><span><span class="hljs-attr">target</span></span><span>=</span><span><span class="hljs-string">"_blank"</span></span><span>
        </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-4 py-2 bg-green-600 text-white rounded-lg shadow"</span></span><span>
      &gt;
        Open 3D Model
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span>
        </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-4 py-2 bg-gray-100 border rounded-lg"</span></span><span>
        </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt;
          alert("If your device supports AR, an AR button will appear on the model.")
        }
      &gt;
        Launch AR
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
) : (
  </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-gray-500 mt-2"</span></span><span>&gt;3D Model not available.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
)}
</span></span></code></div></div></pre>
