</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-variable constant_">PLANTS</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./data/plants"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">App</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [favorites, setFavorites] = </span><span><span class="hljs-title function_">useState</span></span><span>([]);

  </span><span><span class="hljs-keyword">const</span></span><span> </span><span><span class="hljs-title function_">toggleFav</span></span><span> = (</span><span><span class="hljs-params">id</span></span><span>) =&gt; {
    </span><span><span class="hljs-title function_">setFavorites</span></span><span>(</span><span><span class="hljs-function">(<span class="hljs-params">prev</span></span></span><span>) =&gt;
      prev.</span><span><span class="hljs-title function_">includes</span></span><span>(id) ? prev.</span><span><span class="hljs-title function_">filter</span></span><span>(</span><span><span class="hljs-function">(<span class="hljs-params">x</span></span></span><span>) =&gt; x !== id) : [...prev, id]
    );
  };

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Navbar</span></span></span><span> /&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">main</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"container mx-auto px-4 py-8"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Routes</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span>
            </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/"</span></span><span>
            </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>
              &lt;&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-3xl font-bold text-center"</span></span><span>&gt;
                  Virtual Herbal Garden
                </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-center text-gray-600 mb-6"</span></span><span>&gt;
                  Explore Indian Medicinal Plants Across AYUSH Systems
                </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">ZoneSelector</span></span></span><span> /&gt;

                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-10"</span></span><span>&gt;
                  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-xl font-semibold mb-4"</span></span><span>&gt;
                    Featured Plants
                  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;

                  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"</span></span><span>&gt;
                    {PLANTS.map((p) =&gt; (
                      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>
                        </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{p.id}</span></span><span>
                        </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-white p-4 rounded-lg shadow"</span></span><span>
                      &gt;
                        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span>
                          </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{p.image}</span></span><span>
                          </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"h-40 w-full object-cover rounded"</span></span><span>
                        /&gt;
                        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3 font-semibold"</span></span><span>&gt;{p.commonName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
                      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
                    ))}
                  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
            }
          /&gt;

          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span>
            </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/zone/:zoneName"</span></span><span>
            </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>
              &lt;</span><span><span class="hljs-attr">ZonePage</span></span><span> </span><span><span class="hljs-attr">favorites</span></span><span>=</span><span><span class="hljs-string">{favorites}</span></span><span> </span><span><span class="hljs-attr">onToggleFav</span></span><span>=</span><span><span class="hljs-string">{toggleFav}</span></span><span> /&gt;
            }
          /&gt;

          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/quiz"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">QuizPage</span></span><span> /&gt;} /&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Routes</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">main</span></span></span><span>&gt;

      </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">footer</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-gray-50 py-4 text-center text-sm"</span></span><span>&gt;
        © Virtual Herbal Garden — AYUSH Learning Project
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">footer</span></span></span><span>&gt;
    &lt;/div&gt;
  );
}
</span></span></code></div></div></pre>
