        </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">{plant.commonName}</span></span><span>
        </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"w-full h-48 object-cover rounded-lg mt-4"</span></span><span>
      /&gt;

