057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-js"><span><span><span class="hljs-keyword">import</span></span><span> { defineConfig } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"vite"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> react </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"@vitejs/plugin-react"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title function_">defineConfig</span></span><span>({
  </span><span><span class="hljs-attr">plugins</span></span><span>: [</span><span><span class="hljs-title function_">react</span></span><span>()],
  </span><span><span class="hljs-attr">optimizeDeps</span></span><span>: {
    </span><span><span class="hljs-attr">include</span></span><span>: [</span><span><span class="hljs-string">"@google/model-viewer"</span></span><span>],
  },
});
</span></span></code></div></div></pre>
<p data-start="1327" data-end="1395">✔ This tells Vite:<br data-start="1345" data-end="1348">
<strong data-start="1348" data-end="1395">Do NOT re-bundle or re-define model-viewer.</strong></p>
<hr data-start="1397" data-end="1400">
<h1 data-start="1402" data-end="1422">❗ VERY IMPORTANT</h1>
<p data-start="1423" data-end="1452">If you do NOT have this line:</p>
