</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">React</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">Link</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react-router-dom"</span></span><span>;

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">AyushPage</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> systems = [
    {
      </span><span><span class="hljs-attr">id</span></span><span>: </span><span><span class="hljs-string">"ayurveda"</span></span><span>,
      </span><span><span class="hljs-attr">title</span></span><span>: </span><span><span class="hljs-string">"Ayurveda"</span></span><span>,
      </span><span><span class="hljs-attr">desc</span></span><span>: </span><span><span class="hljs-string">"Traditional herbal healing system using diet &amp; herbs."</span></span><span>,
      </span><span><span class="hljs-attr">color</span></span><span>: </span><span><span class="hljs-string">"bg-amber-100"</span></span><span>,
    },
    {
      </span><span><span class="hljs-attr">id</span></span><span>: </span><span><span class="hljs-string">"yoga_naturopathy"</span></span><span>,
      </span><span><span class="hljs-attr">title</span></span><span>: </span><span><span class="hljs-string">"Yoga &amp; Naturopathy"</span></span><span>,
      </span><span><span class="hljs-attr">desc</span></span><span>: </span><span><span class="hljs-string">"Detox, yoga postures, breathing &amp; natural therapies."</span></span><span>,
      </span><span><span class="hljs-attr">color</span></span><span>: </span><span><span class="hljs-string">"bg-teal-100"</span></span><span>,
    },
    {
      </span><span><span class="hljs-attr">id</span></span><span>: </span><span><span class="hljs-string">"unani"</span></span><span>,
      </span><span><span class="hljs-attr">title</span></span><span>: </span><span><span class="hljs-string">"Unani"</span></span><span>,
      </span><span><span class="hljs-attr">desc</span></span><span>: </span><span><span class="hljs-string">"Persian–Arab herbal system based on body temperament."</span></span><span>,
      </span><span><span class="hljs-attr">color</span></span><span>: </span><span><span class="hljs-string">"bg-blue-100"</span></span><span>,
    },
    {
      </span><span><span class="hljs-attr">id</span></span><span>: </span><span><span class="hljs-string">"siddha"</span></span><span>,
      </span><span><span class="hljs-attr">title</span></span><span>: </span><span><span class="hljs-string">"Siddha"</span></span><span>,
      </span><span><span class="hljs-attr">desc</span></span><span>: </span><span><span class="hljs-string">"Ancient Tamil medicinal system focusing on lifestyle &amp; herbs."</span></span><span>,
      </span><span><span class="hljs-attr">color</span></span><span>: </span><span><span class="hljs-string">"bg-purple-100"</span></span><span>,
    },
    {
      </span><span><span class="hljs-attr">id</span></span><span>: </span><span><span class="hljs-string">"homeopathy"</span></span><span>,
      </span><span><span class="hljs-attr">title</span></span><span>: </span><span><span class="hljs-string">"Homeopathy"</span></span><span>,
      </span><span><span class="hljs-attr">desc</span></span><span>: </span><span><span class="hljs-string">"Alternative medicine using diluted remedies."</span></span><span>,
      </span><span><span class="hljs-attr">color</span></span><span>: </span><span><span class="hljs-string">"bg-rose-100"</span></span><span>,
    },
  ];

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"container mx-auto px-4 py-8"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-3xl font-bold text-center mb-8"</span></span><span>&gt;AYUSH Systems</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"</span></span><span>&gt;
        {systems.map((s) =&gt; (
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Link</span></span></span><span>
            </span><span><span class="hljs-attr">to</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>`/</span><span><span class="hljs-attr">ayush</span></span><span>/${</span><span><span class="hljs-attr">s.id</span></span><span>}`}
            </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{s.id}</span></span><span>
            </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>`</span><span><span class="hljs-attr">p-6</span></span><span> </span><span><span class="hljs-attr">rounded-2xl</span></span><span> </span><span><span class="hljs-attr">shadow-lg</span></span><span> </span><span><span class="hljs-attr">hover:shadow-xl</span></span><span> </span><span><span class="hljs-attr">transition</span></span><span> ${</span><span><span class="hljs-attr">s.color</span></span><span>}`}
          &gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-2xl font-semibold"</span></span><span>&gt;{s.title}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-2 text-gray-700"</span></span><span>&gt;{s.desc}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Link</span></span></span><span>&gt;
        ))}
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
