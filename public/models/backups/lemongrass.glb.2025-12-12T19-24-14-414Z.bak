.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">PlantDetailModal</span></span><span>(</span><span><span class="hljs-params">{ plantId, onClose, onToggleFav, isFav }</span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [plant, setPlant] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-literal">null</span></span><span>);

  </span><span><span class="hljs-title function_">useEffect</span></span><span>(</span><span><span class="hljs-function">() =&gt;</span></span><span> {
    </span><span><span class="hljs-keyword">let</span></span><span> mounted = </span><span><span class="hljs-literal">true</span></span><span>;
    </span><span><span class="hljs-keyword">if</span></span><span> (plantId) {
      </span><span><span class="hljs-title function_">apiFetchPlantById</span></span><span>(plantId).</span><span><span class="hljs-title function_">then</span></span><span>(</span><span><span class="hljs-function">(<span class="hljs-params">p</span></span></span><span>) =&gt; mounted &amp;&amp; </span><span><span class="hljs-title function_">setPlant</span></span><span>(p));
    }
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-function">() =&gt;</span></span><span> (mounted = </span><span><span class="hljs-literal">false</span></span><span>);
  }, [plantId]);

  </span><span><span class="hljs-keyword">if</span></span><span> (!plant) </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-literal">null</span></span><span>;

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"fixed inset-0 z-50 flex items-center justify-center p-4"</span></span><span> </span><span><span class="hljs-attr">role</span></span><span>=</span><span><span class="hljs-string">"dialog"</span></span><span> </span><span><span class="hljs-attr">aria-modal</span></span><span>=</span><span><span class="hljs-string">"true"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"absolute inset-0 bg-black/50"</span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{onClose}</span></span><span> /&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"relative bg-white rounded-2xl max-w-4xl w-full shadow-2xl overflow-auto"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"p-6 grid grid-cols-1 md:grid-cols-3 gap-6"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"md:col-span-1"</span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>`${</span><span><span class="hljs-attr">plant.image</span></span><span>}?</span><span><span class="hljs-attr">w</span></span><span>=</span><span><span class="hljs-string">1200&amp;q</span></span><span>=</span><span><span class="hljs-string">80&amp;auto</span></span><span>=</span><span><span class="hljs-string">format&amp;fit</span></span><span>=</span><span><span class="hljs-string">crop</span></span><span>`} </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">{plant.commonName}</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"rounded-lg w-full h-60 object-cover"</span></span><span> /&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4 text-2xl font-bold"</span></span><span>&gt;{plant.commonName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-sm italic text-gray-500"</span></span><span>&gt;{plant.scientificName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3 flex gap-2"</span></span><span>&gt;
              {plant.systems.map((s) =&gt; </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Badge</span></span></span><span> </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{s}</span></span><span>&gt;{s}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Badge</span></span></span><span>&gt;)}
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4 space-y-2 text-sm"</span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;Family:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt; {plant.family}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;Main uses:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt; {plant.uses?.join(", ")}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"md:col-span-2"</span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-lg font-semibold"</span></span><span>&gt;Overview</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-2 text-gray-700"</span></span><span>&gt;{plant.description}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

            {/* MODEL / AR SECTION */}
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">section</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-6"</span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h4</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;Interactive Tools</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h4</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-sm text-gray-600 mt-2"</span></span><span>&gt;View a 3D model or launch AR on supported devices.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4 space-y-4"</span></span><span>&gt;
                {plant.model ? (
                  </span><span><span class="hljs-tag">&lt;&gt;</span></span><span>
                    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"rounded-lg overflow-hidden border"</span></span><span>&gt;
                      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">model-viewer</span></span></span><span>
                        </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{plant.model}</span></span><span>
                        </span><span><span class="hljs-attr">ios-src</span></span><span>=</span><span><span class="hljs-string">{plant.usdz}</span></span><span>
                        </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">{plant.commonName}</span></span><span>
                        </span><span><span class="hljs-attr">ar</span></span><span>
                        </span><span><span class="hljs-attr">ar-modes</span></span><span>=</span><span><span class="hljs-string">"webxr scene-viewer quick-look"</span></span><span>
                        </span><span><span class="hljs-attr">camera-controls</span></span><span>
                        </span><span><span class="hljs-attr">auto-rotate</span></span><span>
                        </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">width:</span></span><span> "</span><span><span class="hljs-attr">100</span></span><span>%", </span><span><span class="hljs-attr">height:</span></span><span> "</span><span><span class="hljs-attr">400px</span></span><span>" }}
                      /&gt;
                    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

                    </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"flex gap-3"</span></span><span>&gt;
                      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">a</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-4 py-2 bg-emerald-600 text-white rounded-lg shadow-sm"</span></span><span> </span><span><span class="hljs-attr">href</span></span><span>=</span><span><span class="hljs-string">{plant.model}</span></span><span> </span><span><span class="hljs-attr">target</span></span><span>=</span><span><span class="hljs-string">"_blank"</span></span><span> </span><span><span class="hljs-attr">rel</span></span><span>=</span><span><span class="hljs-string">"noreferrer"</span></span><span>&gt;Open 3D (new tab)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">a</span></span></span><span>&gt;
                      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-4 py-2 border rounded-lg"</span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; alert('If your device supports AR, the model viewer will show an AR button on the model.')}&gt;Launch AR (if supported)</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
                    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
                  </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
                ) : (
                  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-sm text-gray-500"</span></span><span>&gt;3D model not available for this plant.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
                )}
              </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;

            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">section</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-6"</span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h4</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;Preparation &amp; Safety Notes</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h4</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"list-disc list-inside mt-2 text-gray-700 text-sm"</span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Traditional uses vary — consult authoritative sources before use.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Not a replacement for medical advice; check contraindications and dosages.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;

            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">section</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-6"</span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h4</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;References</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h4</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-sm text-gray-600 mt-2"</span></span><span>&gt;Curated references and research links will appear here in the final project.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"p-4 border-t flex justify-between items-center"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; onToggleFav(plant.id)} className="px-3 py-2 rounded-lg border mr-2"&gt;{isFav ? 'Remove from Favorites' : 'Add to Favorites'}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-3 py-2 rounded-lg border"</span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; navigator.clipboard?.writeText(window.location.href)}&gt;Share</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{onClose}</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-4 py-2 rounded-lg bg-gray-100"</span></span><span>&gt;Close</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
    &lt;/div&gt;
  );
}
</span></span></code></div></div></pre>
<hr data-start="15800" data-end="15803">
<h2 data-start="15805" data-end="15850">10) Quick dev checklist to test everything</h2>
<ol data-start="15852" data-end="16167">
<li data-start="15852" data-end="15889">
<p data-start="15855" data-end="15889"><code data-start="15855" data-end="15889">npm install @google/model-viewer</code></p>
</li>
<li data-start="15890" data-end="15938">
<p data-start="15893" data-end="15938">Replace <code data-start="15901" data-end="15909">PLANTS</code> with the expanded list above</p>
</li>
<li data-start="15939" data-end="16008">
<p data-start="15942" data-end="16008">Paste the updated <code data-start="15960" data-end="15978">PlantDetailModal</code> (or modify your existing one)</p>
</li>
<li data-start="16009" data-end="16100">
<p data-start="16012" data-end="16100">Add at least one <code data-start="16029" data-end="16035">.glb</code> file to <code data-start="16044" data-end="16076">client/public/models/tulsi.glb</code> so you can test locally</p>
</li>
<li data-start="16101" data-end="16167">
<p data-start="16104" data-end="16167"><code data-start="16104" data-end="16117">npm run dev</code> → open a Tulsi card → the 3D viewer should appear</p>
</li>
</ol>
<hr data-start="16169" data-end="16172">
<h2 data-start="16174" data-end="16235">11) If you don’t have GLB files yet — quick temporary demo</h2>
<p data-start="16236" data-end="16365">If you want to test immediately without downloading models, you can use a public sample GLB URL for testing. Example (temporary):</p>
<pre class="overflow-visible!" data-start="16367" data-end="16469"><div class="contain-inline-size rounded-2xl relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl">js</div><div class="sticky top-9"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Copy"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon-sm"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4.44063 16.7428 4.63025 16.7797 4.91211 16.8027C5.29563 16.8341 5.78896 16.835 6.5 16.835H9.33301C10.0439 16.835 10.5374 16.8341 10.9209 16.8027C11.2965 16.772 11.508 16.7152 11.666 16.6348L11.793 16.5645C12.0804 16.3881 12.3148 16.1351 12.4688 15.833L12.5244 15.7031C12.5759 15.5594 12.6137 15.3698 12.6367 15.0879C12.6681 14.7044 12.668 14.211 12.668 13.5V10.667ZM13.998 12.665C14.4528 12.6634 14.8011 12.6602 15.0879 12.6367C15.4635 12.606 15.675 12.5492 15.833 12.4688L15.959 12.3975C16.2466 12.2211 16.4808 11.9682 16.6348 11.666L16.6914 11.5361C16.7428 11.3924 16.7797 11.2026 16.8027 10.9209C16.8341 10.5374 16.835 10.0439 16.835 9.33301V6.5C16.835 5.78896 16.8341 5.29563 16.8027 4.91211C16.7797 4.63025 16.7428 4.44063 16.6914 4.29688L16.6348 4.16699C16.4807 3.86474 16.2466 3.61186 15.959 3.43555L15.833 3.36524C15.675 3.28473 15.4636 3.22797 15.0879 3.19727C14.7044 3.16593 14.211 3.16504 13.5 3.16504H10.667C9.9561 3.16504 9.46259 3.16595 9.0791 3.19727C8.79739 3.22028 8.6076 3.2572 8.46387 3.30859L8.33399 3.36524C8.03176 3.51923 7.77886 3.75343 7.60254 4.04102L7.53125 4.16699C7.4508 4.32498 7.39397 4.53655 7.36328 4.91211C7.33985 5.19893 7.33562 5.54719 7.33399 6.00195H9.33301C10.022 6.00195 10.5791 6.00131 11.0293 6.03809C11.4873 6.07551 11.8937 6.15471 12.2705 6.34668L12.4883 6.46875C12.984 6.7728 13.3878 7.20854 13.6533 7.72949L13.7197 7.87207C13.8642 8.20859 13.9292 8.56974 13.9619 8.9707C13.9987 9.42092 13.998 9.97799 13.998 10.667V12.665ZM18.165 9.33301C18.165 10.022 18.1657 10.5791 18.1289 11.0293C18.0961 11.4302 18.0311 11.7914 17.8867 12.1279L17.8203 12.2705C17.5549 12.7914 17.1509 13.2272 16.6553 13.5313L16.4365 13.6533C16.0599 13.8452 15.6541 13.9245 15.1963 13.9619C14.8593 13.9895 14.4624 13.9935 13.9951 13.9951C13.9935 14.4624 13.9895 14.8593 13.9619 15.1963C13.9292 15.597 13.864 15.9576 13.7197 16.2939L13.6533 16.4365C13.3878 16.9576 12.9841 17.3941 12.4883 17.6982L12.2705 17.8203C11.8937 18.0123 11.4873 18.0915 11.0293 18.1289C10.5791 18.1657 10.022 18.165 9.33301 18.165H6.5C5.81091 18.165 5.25395 18.1657 4.80371 18.1289C4.40306 18.0962 4.04235 18.031 3.70606 17.8867L3.56348 17.8203C3.04244 17.5548 2.60585 17.151 2.30176 16.6553L2.17969 16.4365C1.98788 16.0599 1.90851 15.6541 1.87109 15.1963C1.83431 14.746 1.83496 14.1891 1.83496 13.5V10.667C1.83496 9.978 1.83432 9.42091 1.87109 8.9707C1.90851 8.5127 1.98772 8.10625 2.17969 7.72949L2.30176 7.51172C2.60586 7.0159 3.04236 6.6122 3.56348 6.34668L3.70606 6.28027C4.04237 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-js"><span><span><span class="hljs-comment">// For test only:</span></span><span>
plant.</span><span><span class="hljs-property">model</span></span><span> = </span><span><span class="hljs-string">"https://modelviewer.dev/shared-assets/models/Astronaut.glb"</span></span><span>
</span></span></code></div></div></pre>
<p data-start="16471" data-end="16563">Replace <code data-start="16479" data-end="16492">plant.model</code> for one plant with that public URL — you’ll see the model immediately.</p>
<hr data-start="16565" data-end="16568">
<h2 data-start="16570" data-end="16614">12) Extra-credit ideas (for better marks)</h2>
<ul data-start="16615" data-end="16988">
<li data-start="16615" data-end="16735">
<p data-start="16617" data-end="16735">Host a few high-quality custom GLB models (close-to-real plant) for 3–4 key herbs. Emphasize quality in your report.</p>
</li>
<li data-start="16736" data-end="16842">
<p data-start="16738" data-end="16842">Add a short demo video showing AR interaction (record on your phone) and include it in the submission.</p>
</li>
<li data-start="16843" data-end="16932">
<p data-start="16845" data-end="16932">Mention sources for your 3D assets and include attribution in the References section.</p>
</li>
<li data-start="16933" data-end="16988">
<p data-start="16935" data-end="16988">Provide a small “How to use AR” help modal for users.</p>
</li>
</ul>
<hr data-start="16990" data-end="16993">
<p data-start="16995" data-end="17014">If you want, I can:</p>
<ul data-start="17015" data-end="17262">
<li data-start="17015" data-end="17141">
<p data-start="17017" data-end="17141">Generate a few <strong data-start="17032" data-end="17052">sample GLB files</strong> URLs for testing (public models), and update the PLANTS array to use them immediately.</p>
</li>
<li data-start="17142" data-end="17262">
<p data-start="17144" data-end="17262">Or I can provide step-by-step commands to <strong data-start="17186" data-end="17198">download</strong> a model from Sketchfab and convert to <code data-start="17237" data-end="17243">.glb</code> using Blender CLI.</p>
</li>
</ul>
<p data-start="17264" data-end="17304">Which would you like me to do right now?</p>
<ol data-start="17305" data-end="17505" data-is-last-node="" data-is-only-node="">
<li data-start="17305" data-end="17415">
<p data-start="17308" data-end="17415">Paste-ready PLANTS already provided + a <strong data-start="17348" data-end="17367">public test GLB</strong> linked so you can click and test immediately.</p>
</li>
<li data-start="17416" data-end="17505" data-is-last-node="">
<p data-start="17419" data-end="17505" data-is-last-node="">Steps to download &amp; convert actual plant GLB files (Sketchfab → Blender → export glb).</p>
</li>
</ol></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4.44063 16.7428 4.63025 16.7797 4.91211 16.8027C5.29563 16.8341 5.7889