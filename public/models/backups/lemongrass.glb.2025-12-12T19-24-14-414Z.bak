        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"flex gap-2"</span></span><span>&gt;
          {plant.systems.map((s) =&gt; (
