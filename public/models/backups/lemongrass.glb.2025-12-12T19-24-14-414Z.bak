          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Link</span></span></span><span> </span><span><span class="hljs-attr">to</span></span><span>=</span><span><span class="hljs-string">"/zone/Homeopathy"</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"hover:underline"</span></span><span>&gt;Homeopathy</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Link</span></span></span><span>&gt;

