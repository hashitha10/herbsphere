                    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
                  </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
                ) : (
                  </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-sm text-gray-500"</span></span><span>&gt;
                    3D model not available for this plant.
                  </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
                )}
              </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;
            {/* ⭐⭐⭐ END OF 3D / AR SECTION ⭐⭐⭐ */}

            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">section</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-6"</span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h4</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;Preparation &amp; Safety Notes</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h4</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">ul</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"list-disc list-inside mt-2 text-gray-700 text-sm"</span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Traditional uses vary — verify with authoritative sources.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">li</span></span></span><span>&gt;Not medical advice. Always check contraindications.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">li</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">ul</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;

            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">section</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-6"</span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h4</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold"</span></span><span>&gt;References</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h4</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-sm text-gray-600 mt-2"</span></span><span>&gt;
                Research references will appear here in the final version.
              </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">section</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

        {/* FOOTER BUTTONS */}
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"p-4 border-t flex justify-between items-center"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span>
              </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; onToggleFav(plant.id)}
              className="px-3 py-2 rounded-lg border mr-2"
            &gt;
              {isFav ? "Remove from Favorites" : "Add to Favorites"}
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span>
              </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-3 py-2 rounded-lg border"</span></span><span>
              </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; navigator.clipboard?.writeText(window.location.href)}
            &gt;
              Share
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{onClose}</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-4 py-2 rounded-lg bg-gray-100"</span></span><span>&gt;
            Close
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
    &lt;/div&gt;
  );
}
</span></span></code></div></div></pre>
