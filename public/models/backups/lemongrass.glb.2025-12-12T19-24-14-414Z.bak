057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copy code</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre! language-jsx"><span><span><span class="hljs-comment">// client/src/App.jsx</span></span><span>
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">React</span></span><span>, { useState } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> { </span><span><span class="hljs-title class_">Routes</span></span><span>, </span><span><span class="hljs-title class_">Route</span></span><span> } </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"react-router-dom"</span></span><span>;

</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">HomePage</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./pages/HomePage"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">PlantModal</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./components/PlantModal"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">AyushPage</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./pages/AyushPage"</span></span><span>;
</span><span><span class="hljs-keyword">import</span></span><span> </span><span><span class="hljs-title class_">SystemPlantsPage</span></span><span> </span><span><span class="hljs-keyword">from</span></span><span> </span><span><span class="hljs-string">"./pages/SystemPlantsPage"</span></span><span>;

</span><span><span class="hljs-keyword">function</span></span><span> </span><span><span class="hljs-title function_">App</span></span><span>(</span><span><span class="hljs-params"></span></span><span>) {
  </span><span><span class="hljs-keyword">const</span></span><span> [selectedPlant, setSelectedPlant] = </span><span><span class="hljs-title function_">useState</span></span><span>(</span><span><span class="hljs-literal">null</span></span><span>);

  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;&gt;</span></span></span><span>
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Routes</span></span></span><span>&gt;
        {/* Home Page */}
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span>
          </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/"</span></span><span>
          </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">HomePage</span></span><span> </span><span><span class="hljs-attr">onPlantClick</span></span><span>=</span><span><span class="hljs-string">{(p)</span></span><span> =&gt; setSelectedPlant(p)} /&gt;}
        /&gt;

        {/* AYUSH Dashboard */}
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span> </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/ayush"</span></span><span> </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">AyushPage</span></span><span> /&gt;} /&gt;

        {/* System-wise Plants */}
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Route</span></span></span><span>
          </span><span><span class="hljs-attr">path</span></span><span>=</span><span><span class="hljs-string">"/ayush/:systemId"</span></span><span>
          </span><span><span class="hljs-attr">element</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>&lt;</span><span><span class="hljs-attr">SystemPlantsPage</span></span><span> </span><span><span class="hljs-attr">onPlantSelect</span></span><span>=</span><span><span class="hljs-string">{setSelectedPlant}</span></span><span> /&gt;}
        /&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Routes</span></span></span><span>&gt;

      {/* PLANT MODAL */}
      {selectedPlant &amp;&amp; (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">PlantModal</span></span></span><span>
          </span><span><span class="hljs-attr">plant</span></span><span>=</span><span><span class="hljs-string">{selectedPlant}</span></span><span>
          </span><span><span class="hljs-attr">onClose</span></span><span>=</span><span><span class="hljs-string">{()</span></span><span> =&gt; setSelectedPlant(null)}
        /&gt;
      )}
    </span><span><span class="hljs-tag">&lt;/&gt;</span></span><span>
  );
}

</span><span><span class="hljs-keyword">export</span></span><span> </span><span><span class="hljs-keyword">default</span></span><span> </span><span><span class="hljs-title class_">App</span></span><span>;
</span></span></code></div></div></pre>
