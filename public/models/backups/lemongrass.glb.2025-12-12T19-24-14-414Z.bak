  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"flex gap-3 justify-center my-6 flex-wrap"</span></span><span>&gt;
      {zones.map(z =&gt; (
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">Link</span></span></span><span> </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{z}</span></span><span> </span><span><span class="hljs-attr">to</span></span><span>=</span><span><span class="hljs-string">{</span></span><span>`/</span><span><span class="hljs-attr">zone</span></span><span>/${</span><span><span class="hljs-attr">encodeURIComponent</span></span><span>(</span><span><span class="hljs-attr">z</span></span><span>)}`}
          </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-4 py-2 bg-emerald-600 text-white rounded-full shadow-sm hover:bg-emerald-800"</span></span><span>&gt;
          {z}
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Link</span></span></span><span>&gt;
      ))}
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
