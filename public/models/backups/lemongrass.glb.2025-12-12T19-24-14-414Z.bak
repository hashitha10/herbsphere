    </span><span><span class="hljs-attr">uses</span></span><span>: [</span><span><span class="hljs-string">"Skin"</span></span><span>, </span><span><span class="hljs-string">"Oral"</span></span><span>, </span><span><span class="hljs-string">"Anti-microbial"</span></span><span>],
