6.3254 8.50159 16.9959 9.17228 16.9961 9.99963C16.9961 10.8271 16.3256 11.4987 15.498 11.4987C14.6705 11.4987 14 10.8271 14 9.99963C14.0002 9.17228 14.6706 8.50159 15.498 8.50159Z"></path><path d="M4.49805 8.50159C5.32544 8.50159 5.99689 9.17228 5.99707 9.99963C5.99707 10.8271 5.32555 11.4987 4.49805 11.4987C3.67069 11.4985 3 10.827 3 9.99963C3.00018 9.17239 3.6708 8.50176 4.49805 8.50159Z"></path><path d="M10.0003 8.50159C10.8276 8.50176 11.4982 9.17239 11.4984 9.99963C11.4984 10.827 10.8277 11.4985 10.0003 11.4987C9.17283 11.4987 8.50131 10.8271 8.50131 9.99963C8.50149 9.17228 9.17294 8.50159 10.0003 8.50159Z"></path></svg></button></div></div></div></div></article><article class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-(--header-height)" tabindex="-1" dir="auto" data-turn-id="7ac7cb8b-f902-41a3-8c38-85928a7eab9a" data-testid="conversation-turn-151" data-scroll-anchor="false" data-turn="user"><h5 class="sr-only">You said:</h5><div class="text-base my-auto mx-auto pt-12 [--thread-content-margin:--spacing(4)] thread-sm:[--thread-content-margin:--spacing(6)] thread-lg:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] thread-lg:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col" tabindex="-1"><div class="flex max-w-full flex-col grow"><div data-message-author-role="user" data-message-id="7ac7cb8b-f902-41a3-8c38-85928a7eab9a" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color relative rounded-[18px] px-4 py-1.5 data-[multiline]:py-3 max-w-[var(--user-chat-width,70%)]" data-multiline=""><div class="whitespace-pre-wrap">// client/src/components/PlantModal.jsx
import React from "react";
import "@google/model-viewer";

export default function PlantModal({ plant, onClose }) {
  if (!plant) return null;

  return (
    &lt;div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4"&gt;
      &lt;div className="bg-white w-full max-w-4xl rounded-xl shadow-xl overflow-auto max-h-[90vh]"&gt;
        
        {/* HEADER IMAGE */}
        &lt;div className="relative"&gt;
          &lt;img 
            src={plant.image}
            alt={plant.commonName}
            className="w-full h-64 object-cover rounded-t-xl"
          /&gt;

          {/* CLOSE BUTTON */}
          &lt;button 
            onClick={onClose}
            className="absolute top-3 right-3 bg-white px-3 py-1 rounded-full shadow font-bold"
          &gt;
            ✕
          &lt;/button&gt;
        &lt;/div&gt;

        {/* DETAILS */}
        &lt;div className="p-6"&gt;

          &lt;h1 className="text-3xl font-bold"&gt;{plant.commonName}&lt;/h1&gt;
          &lt;p className="italic text-gray-500"&gt;{plant.scientificName}&lt;/p&gt;

          {/* SYSTEM BADGES */}
          &lt;div className="mt-3 flex gap-2 flex-wrap"&gt;
            {plant.systems.map((s) =&gt; (
              &lt;span key={s} className="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs"&gt;
                {s}
              &lt;/span&gt;
            ))}
          &lt;/div&gt;

          &lt;p className="mt-4 text-gray-700"&gt;{plant.description}&lt;/p&gt;

          &lt;p className="mt-3"&gt;&lt;strong&gt;Family:&lt;/strong&gt; {plant.family}&lt;/p&gt;

          &lt;p className="mt-1"&gt;&lt;strong&gt;Uses:&lt;/strong&gt; {plant.uses.join(", ")}&lt;/p&gt;

          {/* 3D MODEL */}
          {plant.model ? (
            &lt;div className="mt-6"&gt;
              &lt;h2 className="text-xl font-semibold mb-2"&gt;3D Model Preview&lt;/h2&gt;
              &lt;div className="mt-4 border rounded-xl overflow-hidden shadow"&gt;
                &lt;model-viewer
                  src={plant.model}
                  ios-src={plant.usdz}
                  alt={plant.commonName}
                  ar
                  ar-modes="webxr scene-viewer quick-look"
                  camera-controls
                  auto-rotate
                  style={{ width: "100%", height: "350px" }}
                &gt;&lt;/model-viewer&gt;

                &lt;div className="flex gap-3 mt-4 p-4"&gt;
                  &lt;a
                    href={plant.model}
                    target="_blank"
                    rel="noreferrer"
                    className="px-4 py-2 bg-green-600 text-white rounded-lg shadow hover:bg-green-700"
                  &gt;
                    Open 3D Model
                  &lt;/a&gt;

                  &lt;button
                    className="px-4 py-2 bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-lg hover:bg-emerald-200"
                    onClick={() =&gt;
                      alert("If your device supports AR, tap the AR button on the model viewer.")
                    }
                  &gt;
                    Launch AR
                  &lt;/button&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          ) : (
            &lt;p className="mt-4 text-gray-500"&gt;3D model not available.&lt;/p&gt;
          )}

          {/* AUDIO GUIDE */}
          {plant.audio &amp;&amp; (
            &lt;div className="mt-6"&gt;
              &lt;h2 className="text-lg font-semibold mb-1"&gt;Audio Guide&lt;/h2&gt;
              &lt;audio controls className="w-full"&gt;
                &lt;source src={plant.audio} type="audio/mp3" /&gt;
              &lt;/audio&gt;
            &lt;/div&gt;
          )}

        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
}here is my plant.jsx file </div></div></div></div></div><div class="z-0 flex justify-end"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none focus-within:transition-none hover:transition-none touch:pointer-events-auto touch:opacity-100 duration-300 group-hover/turn-messages:delay-300 pointer-events-none opacity-0 motion-safe:transition-opacity group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:opacity-100 group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:opacity-100 has-data-[state=open]:pointer-events-auto has-data-[state=open]:opacity-100" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4.44063 16.7428 4.63025 16.7797 4.91211 16.8027C5.29563 16.8341 5.78896 16.835 6.5 16.835H9.33301C10.0439 16.835 10.5374 16.8341 10.9209 16.8027C11.2965 16.772 11.508 16.7152 11.666 16.6348L11.793 16.5645C12.080