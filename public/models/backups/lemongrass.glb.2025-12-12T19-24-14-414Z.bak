</span><span><span class="hljs-comment"># small placeholder MP3 (you can replace later)</span></span><span>
</span><span><span class="hljs-built_in">Invoke-WebRequest</span></span><span> </span><span><span class="hljs-literal">-Uri</span></span><span> </span><span><span class="hljs-string">"https://file-examples.com/wp-content/uploads/2017/11/file_example_MP3_700KB.mp3"</span></span><span> </span><span><span class="hljs-literal">-OutFile</span></span><span> </span><span><span class="hljs-string">"tulsi.mp3"</span></span><span>

</span><span><span class="hljs-comment"># copy for other plants if you want</span></span><span>
</span><span><span class="hljs-built_in">Copy-Item</span></span><span> tulsi.mp3 lemongrass.mp3
</span><span><span class="hljs-built_in">Copy-Item</span></span><span> tulsi.mp3 mint.mp3
</span></span></code></div></div></pre>
<p data-start="2527" data-end="2595">(If that URL fails, just copy any mp3 you have into <code data-start="2579" data-end="2593">public/audio</code>.)</p>
<hr data-start="2597" data-end="2600">
