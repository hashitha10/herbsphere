      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"font-semibold mb-2"</span></span><span>&gt;3D / AR Preview</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h3</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">ARViewer</span></span></span><span> </span><span><span class="hljs-attr">model</span></span><span>=</span><span><span class="hljs-string">{plant.model}</span></span><span> </span><span><span class="hljs-attr">usdz</span></span><span>=</span><span><span class="hljs-string">{plant.usdz}</span></span><span> /&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4"</span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">AudioGuide</span></span></span><span> </span><span><span class="hljs-attr">audio</span></span><span>=</span><span><span class="hljs-string">{plant.audio}</span></span><span> /&gt;
