    </span><span><span class="hljs-attr">scientificName</span></span><span>: </span><span><span class="hljs-string">"Cymbopogon citratus"</span></span><span>,
    </span><span><span class="hljs-attr">systems</span></span><span>: [</span><span><span class="hljs-string">"Yoga &amp; Naturopathy"</span></span><span>],
