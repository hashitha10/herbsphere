    </span><span><span class="hljs-attr">uses</span></span><span>: [</span><span><span class="hljs-string">"Detox"</span></span><span>, </span><span><span class="hljs-string">"Stress relief"</span></span><span>]
  }  ← last object doesn’t need a comma
];
