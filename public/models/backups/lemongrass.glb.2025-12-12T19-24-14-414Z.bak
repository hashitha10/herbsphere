  </span><span><span class="hljs-keyword">return</span></span><span> (
    </span><span><span class="language-xml"><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4"</span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"bg-white w-full max-w-4xl rounded-xl shadow-xl overflow-auto max-h-[90vh]"</span></span><span>&gt;
        
        {/* HEADER IMAGE */}
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"relative"</span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">img</span></span></span><span> 
            </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{plant.image}</span></span><span>
            </span><span><span class="hljs-attr">alt</span></span><span>=</span><span><span class="hljs-string">{plant.commonName}</span></span><span>
            </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"w-full h-64 object-cover rounded-t-xl"</span></span><span>
          /&gt;

          {/* CLOSE BUTTON */}
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">button</span></span></span><span> 
            </span><span><span class="hljs-attr">onClick</span></span><span>=</span><span><span class="hljs-string">{onClose}</span></span><span>
            </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"absolute top-3 right-3 bg-white px-3 py-1 rounded-full shadow font-bold"</span></span><span>
          &gt;
            ✕
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

        {/* DETAILS */}
        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"p-6"</span></span><span>&gt;

          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h1</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-3xl font-bold"</span></span><span>&gt;{plant.commonName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h1</span></span></span><span>&gt;
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"italic text-gray-500"</span></span><span>&gt;{plant.scientificName}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

          {/* SYSTEM BADGES */}
          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3 flex gap-2 flex-wrap"</span></span><span>&gt;
            {plant.systems.map((s) =&gt; (
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">span</span></span></span><span> </span><span><span class="hljs-attr">key</span></span><span>=</span><span><span class="hljs-string">{s}</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs"</span></span><span>&gt;
                {s}
              </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">span</span></span></span><span>&gt;
            ))}
          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;

          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4 text-gray-700"</span></span><span>&gt;{plant.description}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-3"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;Family:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt; {plant.family}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

          </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-1"</span></span><span>&gt;</span><span><span class="hljs-tag">&lt;<span class="hljs-name">strong</span></span></span><span>&gt;Uses:</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">strong</span></span></span><span>&gt; {plant.uses.join(", ")}</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;

          {/* 3D MODEL */}
          {plant.model ? (
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-6"</span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-xl font-semibold mb-2"</span></span><span>&gt;3D Model Preview</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">model-viewer</span></span></span><span>
                </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{plant.model}</span></span><span>
                </span><span><span class="hljs-attr">ios-src</span></span><span>=</span><span><span class="hljs-string">{plant.usdz}</span></span><span>
                </span><span><span class="hljs-attr">ar</span></span><span>
                </span><span><span class="hljs-attr">ar-modes</span></span><span>=</span><span><span class="hljs-string">"webxr scene-viewer quick-look"</span></span><span>
                </span><span><span class="hljs-attr">camera-controls</span></span><span>
                </span><span><span class="hljs-attr">auto-rotate</span></span><span>
                </span><span><span class="hljs-attr">style</span></span><span>=</span><span><span class="hljs-string">{{</span></span><span> </span><span><span class="hljs-attr">width:</span></span><span> "</span><span><span class="hljs-attr">100</span></span><span>%", </span><span><span class="hljs-attr">height:</span></span><span> "</span><span><span class="hljs-attr">350px</span></span><span>" }}
              &gt;</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">model-viewer</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
          ) : (
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">p</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-4 text-gray-500"</span></span><span>&gt;3D model not available.</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">p</span></span></span><span>&gt;
          )}

          {/* AUDIO GUIDE */}
          {plant.audio &amp;&amp; (
            </span><span><span class="hljs-tag">&lt;<span class="hljs-name">div</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"mt-6"</span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">h2</span></span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"text-lg font-semibold mb-1"</span></span><span>&gt;Audio Guide</span><span><span class="hljs-tag">&lt;/<span class="hljs-name">h2</span></span></span><span>&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">audio</span></span></span><span> </span><span><span class="hljs-attr">controls</span></span><span> </span><span><span class="hljs-attr">className</span></span><span>=</span><span><span class="hljs-string">"w-full"</span></span><span>&gt;
                </span><span><span class="hljs-tag">&lt;<span class="hljs-name">source</span></span></span><span> </span><span><span class="hljs-attr">src</span></span><span>=</span><span><span class="hljs-string">{plant.audio}</span></span><span> </span><span><span class="hljs-attr">type</span></span><span>=</span><span><span class="hljs-string">"audio/mp3"</span></span><span> /&gt;
              </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">audio</span></span></span><span>&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
          )}

        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
<hr data-start="3152" data-end="3155">
<h1 data-start="3157" data-end="3201">✅ <strong data-start="3161" data-end="3201">STEP 2 — Ensure ZonePage shows modal</strong></h1>
<p data-start="3203" data-end="3232">Your ZonePage should include:</p>
<pre class="overflow-visible!" data-start="3234" data-end="3358"><div class="contain-inline-size rounded-2xl relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl">jsx</div><div class="sticky top-9"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Copy"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon-sm"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4.44063 16.7428 4.63025 16.7797 4.91211 16.8027C5.29563 16.8341 5.78896 16.835 6.5 16.835H9.33301C10.0439 16.835 10.5374 16.8341 10.9209 16.8027C11.2965 16.772 11.508 16.7152 11.666 16.6348L11.793 16.5645C12.0804 16.3881 12.3148 16.1351 12.4688 15.833L12.5244 15.7031C12.5759 15.5594 12.6137 15.3698 12.6367 15.0879C12.6681 14.7044 12.668 14.211 12.668 13.5V10.667ZM13.998 12.665C14.4528 12.6634 14.8011 12.6602 15.0879 12.6367C15.4635 12.606 15.675 12.5492 15.833 12.4688L15.959 12.3975C16.2466 12.2211 16.4808 11.9682 16.