="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M15.498 8.50159C16.3254 8.50159 16.9959 9.17228 16.9961 9.99963C16.9961 10.8271 16.3256 11.4987 15.498 11.4987C14.6705 11.4987 14 10.8271 14 9.99963C14.0002 9.17228 14.6706 8.50159 15.498 8.50159Z"></path><path d="M4.49805 8.50159C5.32544 8.50159 5.99689 9.17228 5.99707 9.99963C5.99707 10.8271 5.32555 11.4987 4.49805 11.4987C3.67069 11.4985 3 10.827 3 9.99963C3.00018 9.17239 3.6708 8.50176 4.49805 8.50159Z"></path><path d="M10.0003 8.50159C10.8276 8.50176 11.4982 9.17239 11.4984 9.99963C11.4984 10.827 10.8277 11.4985 10.0003 11.4987C9.17283 11.4987 8.50131 10.8271 8.50131 9.99963C8.50149 9.17228 9.17294 8.50159 10.0003 8.50159Z"></path></svg></button></div></div></div></div></article><article class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-(--header-height)" tabindex="-1" dir="auto" data-turn-id="40109bde-465a-43f4-b398-242c1000e0ad" data-testid="conversation-turn-215" data-scroll-anchor="false" data-turn="user"><h5 class="sr-only">You said:</h5><div class="text-base my-auto mx-auto pt-12 [--thread-content-margin:--spacing(4)] thread-sm:[--thread-content-margin:--spacing(6)] thread-lg:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] thread-lg:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col" tabindex="-1"><div class="flex max-w-full flex-col grow"><div data-message-author-role="user" data-message-id="40109bde-465a-43f4-b398-242c1000e0ad" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color relative rounded-[18px] px-4 py-1.5 data-[multiline]:py-3 max-w-[var(--user-chat-width,70%)]" data-multiline=""><div class="whitespace-pre-wrap">// client/src/pages/AyushPage.jsx
import React from "react";
import { Link } from "react-router-dom";

export default function AyushPage() {
  const systems = [
    {
      id: "ayurveda",
      title: "Ayurveda",
      desc: "Traditional herbal healing system using diet &amp; herbs.",
      color: "bg-amber-100",
    },
    {
      id: "yoga_naturopathy",
      title: "Yoga &amp; Naturopathy",
      desc: "Detox, yoga postures, breathing &amp; natural therapies.",
      color: "bg-teal-100",
    },
    {
      id: "unani",
      title: "Unani",
      desc: "Persian–Arab herbal system based on body temperament.",
      color: "bg-blue-100",
    },
    {
      id: "siddha",
      title: "Siddha",
      desc: "Ancient Tamil medicinal system focusing on lifestyle &amp; herbs.",
      color: "bg-purple-100",
    },
    {
      id: "homeopathy",
      title: "Homeopathy",
      desc: "Alternative medicine using diluted remedies.",
      color: "bg-rose-100",
    },
  ];

  return (
    &lt;div className="container mx-auto px-4 py-8"&gt;
      &lt;h1 className="text-3xl font-bold text-center mb-8"&gt;AYUSH Systems&lt;/h1&gt;

      &lt;div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"&gt;
        {systems.map((s) =&gt; (
          &lt;Link
            to={<code>/ayush/${s.id}</code>}
            key={s.id}
            className={<code>p-6 rounded-2xl shadow-lg hover:shadow-xl transition ${s.color}</code>}
          &gt;
            &lt;h2 className="text-2xl font-semibold"&gt;{s.title}&lt;/h2&gt;
            &lt;p className="mt-2 text-gray-700"&gt;{s.desc}&lt;/p&gt;
          &lt;/Link&gt;
        ))}
      &lt;/div&gt;
    &lt;/div&gt;
  );
