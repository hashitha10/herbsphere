    </span><span><span class="hljs-attr">systems</span></span><span>: [</span><span><span class="hljs-string">"Ayurveda"</span></span><span>, </span><span><span class="hljs-string">"Unani"</span></span><span>],
    </span><span><span class="hljs-attr">family</span></span><span>: </span><span><span class="hljs-string">"Meliaceae"</span></span><span>,
    </span><span><span class="hljs-attr">short</span></span><span>: </span><span><span class="hljs-string">"Bitter tree used for skin &amp; blood purification."</span></span><span>,
