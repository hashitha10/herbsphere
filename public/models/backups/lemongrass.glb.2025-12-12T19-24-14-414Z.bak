              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">coneGeometry</span></span></span><span> </span><span><span class="hljs-attr">args</span></span><span>=</span><span><span class="hljs-string">{[0.8,</span></span><span> </span><span><span class="hljs-attr">1.2</span></span><span>, </span><span><span class="hljs-attr">32</span></span><span>]} /&gt;
              </span><span><span class="hljs-tag">&lt;<span class="hljs-name">meshStandardMaterial</span></span></span><span> </span><span><span class="hljs-attr">color</span></span><span>=</span><span><span class="hljs-string">"#00695c"</span></span><span> /&gt;
            </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">mesh</span></span></span><span>&gt;

          </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Suspense</span></span></span><span>&gt;
        </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Stage</span></span></span><span>&gt;

        </span><span><span class="hljs-tag">&lt;<span class="hljs-name">OrbitControls</span></span></span><span> </span><span><span class="hljs-attr">enableZoom</span></span><span>=</span><span><span class="hljs-string">{true}</span></span><span> /&gt;
      </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">Canvas</span></span></span><span>&gt;
    </span><span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span></span></span><span>&gt;
  );
}
</span></span></code></div></div></pre>
