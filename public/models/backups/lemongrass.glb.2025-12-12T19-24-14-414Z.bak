 data-[multiline]:py-3 max-w-[var(--user-chat-width,70%)]" data-multiline=""><div class="whitespace-pre-wrap">// Enhanced Virtual Herbal Garden - Single-file React (App.jsx)
// Drop this file into <code>client/src/App.jsx</code> in a Vite + React + Tailwind project.
// Also include <code>main.jsx</code> as bootstrap (provided below).

import React, { useEffect, useMemo, useState } from "react";
import { BrowserRouter, Routes, Route, Link, useNavigate } from "react-router-dom";

/* --------------------------- Mock data &amp; services -------------------------- */
const PLANTS = [
  {
    id: "tulsi",
    commonName: "Tulsi",
    scientificName: "Ocimum sanctum",
    systems: ["Ayurveda", "Homeopathy"],
    family: "Lamiaceae",
    short: "Holy basil used for immunity &amp; respiratory support.",
    description:
      "Tulsi (Holy Basil) is an adaptogenic herb used in Ayurveda for respiratory health, immunity and stress relief. Traditionally consumed as tea or decoction; also used topically in some preparations.",
    image: "https://images.unsplash.com/photo-1534278931823-94d1d6b1d9b3",
    uses: ["Immunity", "Respiratory", "Stress"],
    quiz: [
      {
        q: "Which family does Tulsi belong to?",
        choices: ["Lamiaceae", "Solanaceae", "Fabaceae", "Asteraceae"],
        a: 0,
      },
    ],
  },
  {
    id: "ashwagandha",
    commonName: "Ashwagandha",
    scientificName: "Withania somnifera",
    systems: ["Ayurveda"],
    family: "Solanaceae",
    short: "A well-known adaptogen for stress and sleep.",
    description:
      "Ashwagandha is used to support stress resilience, cognitive health and sleep quality. It's a key herb in many Rasayana (rejuvenation) formulations in Ayurveda.",
    image: "https://images.unsplash.com/photo-1611078482554-92f6a0a8d9d4",
    uses: ["Stress", "Energy", "Sleep"],
    quiz: [
      {
        q: "What is Ashwagandha commonly used for?",
        choices: ["Stress reduction", "Skin whitening", "Digestion only", "None"],
        a: 0,
      },
    ],
  },
  {
    id: "neem",
    commonName: "Neem",
    scientificName: "Azadirachta indica",
    systems: ["Ayurveda", "Unani"],
    family: "Meliaceae",
    short: "Bitter tree used for skin &amp; blood purification.",
    description:
      "Neem has a long history of topical and oral use for skin conditions, dental hygiene and as an antimicrobial adjunct in traditional systems.",
    image: "https://images.unsplash.com/photo-1549880338-65ddcdfd017b",
    uses: ["Skin", "Oral", "Anti-microbial"],
    quiz: [
      {
        q: "Which is a common traditional use of Neem?",
        choices: ["Skin care", "Memory enhancement", "Vision improvement", "Hearing"],
        a: 0,
      },
    ],
  },
  {
    id: "aloe",
    commonName: "Aloe Vera",
    scientificName: "Aloe barbadensis miller",
    systems: ["Unani", "Siddha", "Ayurveda"],
    family: "Asphodelaceae",
    short: "Soothing gel used topically for burns and skin health.",
    description:
      "Aloe vera gel is commonly used as a topical emollient for burns, wounds and skin hydration. It also appears in internal formulations with caution.",
    image: "https://images.unsplash.com/photo-1550258987-190a2d41a8ba",
    uses: ["Skin", "Topical", "Moisturizer"],
    quiz: [
      {
        q: "Which part of Aloe is commonly used topically?",
        choices: ["Gel", "Root", "Bark", "Seeds"],
        a: 0,
      },
    ],
  },
];

// Simple async mock API (would be replaced by real backend calls)
function apiFetchPlants() {
  return new Promise((resolve) =&gt; setTimeout(() =&gt; resolve(PLANTS), 200));
}

function apiFetchPlantById(id) {
  return new Promise((resolve) =&gt; setTimeout(() =&gt; resolve(PLANTS.find((p) =&gt; p.id === id)), 150));
}

/* ------------------------------- Utilities -------------------------------- */
function useLocalStorage(key, initial) {
  const [state, setState] = useState(() =&gt; {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : initial;
    } catch (e) {
      return initial;
    }
  });
  useEffect(() =&gt; {
    try {
      localStorage.setItem(key, JSON.stringify(state));
    } catch (e) {}
  }, [key, state]);
  return [state, setState];
}

/* ------------------------------ UI Components ------------------------------ */
function Navbar() {
  return (
    &lt;header className="bg-emerald-700 text-white"&gt;
      &lt;div className="container mx-auto flex items-center justify-between py-3 px-4"&gt;
        &lt;Link to="/" className="flex items-center gap-3"&gt;
          &lt;div className="w-10 h-10 rounded-md bg-white/10 flex items-center justify-center font-bold"&gt;VH&lt;/div&gt;
          &lt;div&gt;
            &lt;div className="text-lg font-semibold"&gt;Virtual Herbal Garden&lt;/div&gt;
            &lt;div className="text-xs"&gt;AYUSH — Education &amp; Interactive Demo&lt;/div&gt;
          &lt;/div&gt;
        &lt;/Link&gt;

        &lt;nav className="flex items-center gap-4"&gt;
          &lt;Link to="/favorites" className="hover:underline"&gt;Favorites&lt;/Link&gt;
          &lt;Link to="/quiz" className="hover:underline"&gt;Quiz&lt;/Link&gt;
          &lt;Link to="/ar" className="hover:underline"&gt;AR View&lt;/Link&gt;
        &lt;/nav&gt;
      &lt;/div&gt;
    &lt;/header&gt;
  );
}

function Footer() {
  return (
    &lt;footer className="bg-gray-50 border-t mt-8"&gt;
      &lt;div className="container mx-auto py-6 px-4 text-sm text-gray-600"&gt;© 2025 Virtual Herbal Garden — For educational use only&lt;/div&gt;
    &lt;/footer&gt;
  );
}

function SearchBar({ value, onChange, placeholder }) {
  return (
    &lt;div className="flex items-center gap-2"&gt;
      &lt;input
        className="rounded-lg border px-3 py-2 shadow-sm w-64"
        placeholder={placeholder}
        value={value}
        onChange={(e) =&gt; onChange(e.target.value)}
        aria-label="search plants"
      /&gt;
      &lt;button className="px-3 py-2 rounded-lg bg-emerald-600 text-white"&gt;Search&lt;/button&gt;
    &lt;/div&gt;
  );
}

function Badge({ children }) {
  return &lt;span className="inline-block bg-emerald-100 text-emerald-800 text-xs font-semibold mr-2 px-2.5 py-0.5 rounded"&gt;{children}&lt;/span&gt;;
}

function PlantCard({ plant, onOpen, onToggleFav, isFav }) {
  return (
    &lt;article
      className="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition cursor-pointer"
      onClick={() =&gt; onOpen(plant.id)}
      role="button"
      tabIndex={0}
      onKeyDown={(e) =&gt; e.key === "Enter" &amp;&amp; onOpen(plant.id)}
      aria-labelledby={<code>plant-${plant.id}</code>}
    &gt;
      &lt;div className="h-44 bg-gray-100"&gt;
        &lt;img src={<code>${plant.image}?w=800&amp;q=80&amp;auto=format&amp;fit=crop</code>} alt={plant.commonName} className="w-full h-full object-cover" /&gt;
      &lt;/div&gt;
      &lt;div className="p-4"&gt;
        &lt;div className="flex justify-between items-start"&gt;
          &lt;div&gt;
            &lt;h3 id={<code>plant-${plant.id}</code>} className="text-lg font-semibold"&gt;
              {plant.commonName}
            &lt;/h3&gt;
            &lt;p className="text-sm text-gray-500 italic"&gt;{plant.scientificName}&lt;/p&gt;
          &lt;/div&gt;
          &lt;button
            onClick={(e) =&gt; {
              e.stopPropagation();
              onToggleFav(plant.id);
            }}
            aria-label={<code>favorite-${plant.id}</code>}
            className={<code>p-2 rounded-full border bg-white/80 backdrop-blur-sm ${isFav ? "ring-2 ring-emerald-300" : ""}</code>}
          &gt;
            {isFav ? "★" : "☆"}
          &lt;/button&gt;
        &lt;/div&gt;
        &lt;p className="mt-2 text-sm text-gray-700"&gt;{plant.short}&lt;/p&gt;
        &lt;div className="mt-3"&gt;
          {plant.systems.map((s) =&gt; (
            &lt;Badge key={s}&gt;{s}&lt;/Badge&gt;
          ))}
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/article&gt;
  );
}

function PlantDetailModal({ plantId, onClose, onToggleFav, isFav }) {
  const [plant, setPlant] = useState(null);

  useEffect(() =&gt; {
    let mounted = true;
    if (plantId) {
      apiFetchPlantById(plantId).then((p) =&gt; mounted &amp;&amp; setPlant(p));
    }
    return () =&gt; (mounted = false);
  }, [plantId]);

  if (!plant) return null;

  return (
    &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-4" role="dialog" aria-modal="true"&gt;
      &lt;div className="absolute inset-0 bg-black/50" onClick={onClose} /&gt;
      &lt;div className="relative bg-white rounded-2xl max-w-4xl w-full shadow-2xl overflow-auto"&gt;
        &lt;div className="p-6 grid grid-cols-1 md:grid-cols-3 gap-6"&gt;
          &lt;div className="md:col-span-1"&gt;
            &lt;img src={<code>${plant.image}?w=1200&amp;q=80&amp;auto=format&amp;fit=crop</code>} alt={plant.commonName} className="rounded-lg w-full h-60 object-cover" /&gt;
            &lt;h2 className="mt-4 text-2xl font-bold"&gt;{plant.commonName}&lt;/h2&gt;
            &lt;p className="text-sm italic text-gray-500"&gt;{plant.scientificName}&lt;/p&gt;
            &lt;div className="mt-3 flex gap-2"&gt;
              {plant.systems.map((s) =&gt; (
                &lt;Badge key={s}&gt;{s}&lt;/Badge&gt;
              ))}
            &lt;/div&gt;
            &lt;div className="mt-4 space-y-2 text-sm"&gt;
              &lt;p&gt;
                &lt;strong&gt;Family:&lt;/strong&gt; {plant.family}
              &lt;/p&gt;
              &lt;p&gt;
                &lt;strong&gt;Main uses:&lt;/strong&gt; {plant.uses.join(", ")}
              &lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          &lt;div className="md:col-span-2"&gt;
            &lt;h3 className="text-lg font-semibold"&gt;Overview&lt;/h3&gt;
            &lt;p className="mt-2 text-gray-700"&gt;{plant.description}&lt;/p&gt;

            &lt;section className="mt-6"&gt;
              &lt;h4 className="font-semibold"&gt;Interactive Tools&lt;/h4&gt;
              &lt;p className="text-sm text-gray-600 mt-2"&gt;Placeholder controls for 3D model, guided audio and a plant-specific mini-quiz.&lt;/p&gt;

              &lt;div className="mt-4 flex flex-wrap gap-3"&gt;
                &lt;button className="px-4 py-2 bg-emerald-600 text-white rounded-lg shadow-sm"&gt;View 3D model&lt;/button&gt;
                &lt;button className="px-4 py-2 border rounded-lg"&gt;Play guided audio&lt;/button&gt;
                &lt;button className="px-4 py-2 border rounded-lg" onClick={() =&gt; alert('Quiz starting (demo)')}&gt;Take mini-quiz&lt;/button&gt;
              &lt;/div&gt;
            &lt;/section&gt;

            &lt;section className="mt-6"&gt;
              &lt;h4 className="font-semibold"&gt;Preparation &amp; Safety Notes&lt;/h4&gt;
              &lt;ul className="list-disc list-inside mt-2 text-gray-700 text-sm"&gt;
                &lt;li&gt;Traditional uses vary — consult authoritative sources before use.&lt;/li&gt;
                &lt;li&gt;Not a replacement for medical advice; check contraindications and dosages.&lt;/li&gt;
              &lt;/ul&gt;
            &lt;/section&gt;

            &lt;section className="mt-6"&gt;
              &lt;h4 className="font-semibold"&gt;References&lt;/h4&gt;
              &lt;p className="text-sm text-gray-600 mt-2"&gt;Curated references and research links will appear here in the final project.&lt;/p&gt;
            &lt;/section&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        &lt;div className="p-4 border-t flex justify-between items-center"&gt;
          &lt;div&gt;
            &lt;button onClick={() =&gt; onToggleFav(plant.id)} className="px-3 py-2 rounded-lg border mr-2"&gt;
              {isFav ? 'Remove from Favorites' : 'Add to Favorites'}
            &lt;/button&gt;
            &lt;button className="px-3 py-2 rounded-lg border" onClick={() =&gt; navigator.clipboard?.writeText(window.location.href)}&gt;
              Share
            &lt;/button&gt;
          &lt;/div&gt;
          &lt;div&gt;
            &lt;button onClick={onClose} className="px-4 py-2 rounded-lg bg-gray-100"&gt;Close&lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
}

/* ------------------------------ Pages / Views ------------------------------ */
function HomePage({ onToggleFav, favorites }) {
  const [plants, setPlants] = useState([]);
  const [query, setQuery] = useState("");
  const [filter, setFilter] = useState("All");
  const [selectedId, setSelectedId] = useState(null);

  useEffect(() =&gt; {
    apiFetchPlants().then(setPlants);
  }, []);

  const systems = useMemo(() =&gt; ["All", ...new Set(plants.flatMap((p) =&gt; p.systems))], [plants]);

  const filtered = plants.filter((p) =&gt; {
    const q = query.trim().toLowerCase();
    const matchesQuery = !q || [p.commonName, p.scientificName, p.short, p.uses.join(' ')].join(' ').toLowerCase().includes(q);
    const matchesFilter = filter === 'All' || p.systems.includes(filter);
    return matchesQuery &amp;&amp; matchesFilter;
  });

  return (
    &lt;div&gt;
      &lt;div className="flex items-center justify-between mb-6"&gt;
        &lt;h1 className="text-2xl font-bold"&gt;Explore Medicinal Plants&lt;/h1&gt;
        &lt;div className="flex items-center gap-4"&gt;
          &lt;SearchBar value={query} onChange={setQuery} placeholder="Search plants, uses or scientific name..." /&gt;
          &lt;select value={filter} onChange={(e) =&gt; setFilter(e.target.value)} className="px-3 py-2 rounded-lg border bg-white shadow-sm"&gt;
            {systems.map((s) =&gt; (
              &lt;option key={s} value={s}&gt;{s}&lt;/option&gt;
            ))}
          &lt;/select&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      &lt;div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"&gt;
        {filtered.map((p) =&gt; (
          &lt;PlantCard key={p.id} plant={p} onOpen={setSelectedId} onToggleFav={onToggleFav} isFav={favorites.includes(p.id)} /&gt;
        ))}
      &lt;/div&gt;

      {filtered.length === 0 &amp;&amp; (
        &lt;div className="mt-8 bg-white p-6 rounded-2xl shadow-sm text-center"&gt;
          &lt;h3 className="font-semibold"&gt;No plants found&lt;/h3&gt;
          &lt;p className="text-sm text-gray-600 mt-2"&gt;Try a different search term or filter.&lt;/p&gt;
        &lt;/div&gt;
      )}

      &lt;PlantDetailModal plantId={selectedId} onClose={() =&gt; setSelectedId(null)} onToggleFav={onToggleFav} isFav={favorites.includes(selectedId)} /&gt;

      &lt;div className="mt-8 bg-white p-6 rounded-2xl shadow-sm"&gt;
        &lt;h3 className="font-semibold"&gt;Learning Paths&lt;/h3&gt;
        &lt;p className="text-sm text-gray-600 mt-2"&gt;Curated tracks for students, practitioners and hobbyists — with quizzes, videos and citations.&lt;/p&gt;
        &lt;div className="mt-4 flex gap-3"&gt;
          &lt;button className="px-4 py-2 border rounded-lg"&gt;Beginner: Herbs 101&lt;/button&gt;
          &lt;button className="px-4 py-2 border rounded-lg"&gt;Practitioner: Formulations&lt;/button&gt;
          &lt;button className="px-4 py-2 border rounded-lg"&gt;Research: Studies &amp; Papers&lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
}

function FavoritesPage({ favorites, onToggleFav }) {
  const [plants, setPlants] = useState([]);
  useEffect(() =&gt; {
    apiFetchPlants().then(setPlants);
  }, []);

  const favPlants = plants.filter((p) =&gt; favorites.includes(p.id));

  return (
    &lt;div&gt;
      &lt;h1 className="text-2xl font-bold mb-4"&gt;Your Favorite Plants&lt;/h1&gt;
      {favPlants.length === 0 ? (
        &lt;p className="text-sm text-gray-600"&gt;You don't have favorites yet — click the star on any plant to save it here.&lt;/p&gt;
      ) : (
        &lt;div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"&gt;
          {favPlants.map((p) =&gt; (
            &lt;PlantCard key={p.id} plant={p} onOpen={() =&gt; {}} onToggleFav={onToggleFav} isFav={true} /&gt;
          ))}
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
}

function QuizPage({ favorites }) {
  // Simple quiz runner that pulls quiz questions from favorited plants first
  const [questions, setQuestions] = useState([]);
  const [index, setIndex] = useState(0);
  const [score, setScore] = useState(0);
  useEffect(() =&gt; {
    // build questions from PLANTS where quiz exists
    const pool = PLANTS.flatMap((p) =&gt; (p.quiz || []).map((q) =&gt; ({ ...q, plant: p.commonName })));
    // prefer favorites first
    const favQs = pool.filter((q) =&gt; favorites.includes(PLANTS.find((p) =&gt; p.commonName === q.plant)?.id));
    setQuestions(favQs.length ? favQs : pool);
  }, [favorites]);

  if (questions.length === 0) return &lt;p className="text-sm text-gray-600"&gt;No quizzes available yet.&lt;/p&gt;;

  const q = questions[index];

  function answer(i) {
    if (i === q.a) setScore((s) =&gt; s + 1);
    setIndex((n) =&gt; n + 1);
  }

  return (
    &lt;div&gt;
      &lt;h1 className="text-2xl font-bold mb-4"&gt;Mini Quiz&lt;/h1&gt;
      {index &gt;= questions.length ? (
        &lt;div className="bg-white p-6 rounded-2xl shadow-sm"&gt;
          &lt;h3 className="text-lg font-semibold"&gt;Results&lt;/h3&gt;
          &lt;p className="mt-2"&gt;You scored {score} / {questions.length}&lt;/p&gt;
          &lt;button className="mt-4 px-4 py-2 border rounded-lg" onClick={() =&gt; { setIndex(0); setScore(0); }}&gt;Retry&lt;/button&gt;
        &lt;/div&gt;
      ) : (
        &lt;div className="bg-white p-6 rounded-2xl shadow-sm"&gt;
          &lt;h3 className="text-lg font-semibold"&gt;{q.plant}&lt;/h3&gt;
          &lt;p className="mt-2 text-gray-700"&gt;{q.q}&lt;/p&gt;
          &lt;div className="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3"&gt;
            {q.choices.map((c, i) =&gt; (
              &lt;button key={c} onClick={() =&gt; answer(i)} className="px-4 py-3 border rounded-lg text-left"&gt;{c}&lt;/button&gt;
            ))}
          &lt;/div&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
}

function ARPage() {
  const navigate = useNavigate();
  return (
    &lt;div&gt;
      &lt;h1 className="text-2xl font-bold mb-4"&gt;AR &amp; 3D Prototype&lt;/h1&gt;
      &lt;p className="text-sm text-gray-600"&gt;This is a placeholder page for AR experiences. For a production AR feature, integrate WebXR or use model-viewer &amp; mobile-friendly flows.&lt;/p&gt;
      &lt;div className="mt-6 bg-white p-6 rounded-2xl shadow-sm"&gt;
        &lt;p className="text-sm"&gt;Prototype tools:&lt;/p&gt;
        &lt;div className="mt-4 flex gap-3"&gt;
          &lt;button className="px-4 py-2 border rounded-lg" onClick={() =&gt; alert('AR prototype launch (demo)')}&gt;Launch AR on device&lt;/button&gt;
          &lt;button className="px-4 py-2 border rounded-lg" onClick={() =&gt; navigate('/')}&gt;Back to Garden&lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
}

/* ------------------------------- App Shell -------------------------------- */
export default function App() {
  const [favorites, setFavorites] = useLocalStorage('vhg:favorites', []);

  function toggleFavorite(id) {
    setFavorites((prev) =&gt; (prev.includes(id) ? prev.filter((x) =&gt; x !== id) : [...prev, id]));
  }

  return (
    &lt;BrowserRouter&gt;
      &lt;div className="min-h-screen bg-gradient-to-b from-green-50 to-white"&gt;
        &lt;Navbar /&gt;

        &lt;main className="container mx-auto px-4 py-8"&gt;
          &lt;Routes&gt;
            &lt;Route path="/" element={&lt;HomePage onToggleFav={toggleFavorite} favorites={favorites} /&gt;} /&gt;
            &lt;Route path="/favorites" element={&lt;FavoritesPage favorites={favorites} onToggleFav={toggleFavorite} /&gt;} /&gt;
            &lt;Route path="/quiz" element={&lt;QuizPage favorites={favorites} /&gt;} /&gt;
            &lt;Route path="/ar" element={&lt;ARPage /&gt;} /&gt;
            &lt;Route path="*" element={&lt;div&gt;&lt;h1 className="text-xl font-bold"&gt;Page not found&lt;/h1&gt;&lt;/div&gt;} /&gt;
          &lt;/Routes&gt;
        &lt;/main&gt;

        &lt;Footer /&gt;
      &lt;/div&gt;
    &lt;/BrowserRouter&gt;
  );
}

/* ------------------------------ Additional Notes -------------------------- */

// Where to place this file:
// - client/src/App.jsx -&gt; paste this file
// - client/src/main.jsx -&gt; create with the following content:
//
// import React from 'react'
// import ReactDOM from 'react-dom/client'
// import App from './App'
// import './index.css'
//
// ReactDOM.createRoot(document.getElementById('root')).render(
//   &lt;React.StrictMode&gt;
//     &lt;App /&gt;
//   &lt;/React.StrictMode&gt;
// )
//
// Tailwind: ensure tailwind is configured and src/index.css imports tailwind directives.
// Accessibility &amp; Grading tips:
// 1. Add properly sourced references for each plant (journal links) in the PlantDetail modal.
// 2. Add unit/integration tests (React Testing Library) for critical components.
// 3. Build/host a small backend to persist user accounts &amp; favorites (use MongoDB Atlas) and cite API endpoints in README.
// 4. Add an accessible color contrast report and keyboard navigation checks.
// 5. For extra credit, include an AR demo (model-viewer + a few .glb models) and record a short walkthrough video.

// If you want, I can now:
// - Generate the <code>main.jsx</code>, <code>index.css</code>, and <code>tailwind.config.js</code> files
// - Create a mock backend (Express) and seed database with these plants
// - Add tests and a README with grading checklist
